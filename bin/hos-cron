# ── Post-cycle bookkeeping ────────────────────────────────────────────────────
if [[ $_claude_exit -eq 0 ]]; then
  # #1435: a normally-completing cycle clears the timeout-breaker counter and
  # auto-closes any standing breaker issue — the steady state must not stay
  # "permanently suspended + stale human issue" once the cause is fixed.
  # Mirrors the #959 baseline-green auto-close pattern above.
  _tb_state="$_HOS_DIR/timeout-breaker/${ROLE}-${PROJECT}"
  if [[ -f "$_tb_state" ]]; then
    rm -f "$_tb_state"
    if [[ -n "${_REPO_SLUG:-}" ]]; then
      if _tb_open_nums=$(gh api "repos/${_REPO_SLUG}/issues?state=open&labels=needs-human&per_page=20" \
          --jq "[.[] | select(.title | startswith(\"${_TIMEOUT_BREAKER_TITLE_PREFIX}\"))] | .[].number" \
          2>/dev/null); then
        while IFS= read -r _tb_num; do
          [[ -z "$_tb_num" ]] && continue
          gh issue close "$_tb_num" --repo "$_REPO_SLUG" \
            --comment "Cycle completed normally — auto-closing the timeout-breaker issue." \
            2>/dev/null && echo "$LOG_PREFIX auto-closed timeout-breaker issue #${_tb_num}" \
            || echo "$LOG_PREFIX WARN: failed to auto-close timeout-breaker issue #${_tb_num}"
        done <<< "$_tb_open_nums"
      fi
    fi
  fi

  # #1446: symmetry with the timeout-breaker auto-close above — a normally
  # completing cycle auto-closes any standing usage-limit-breaker issue.
  # There is no counter file to clear here (v1 trips on first detection, no
  # attempt counter), so this is a plain unconditional query, not gated on a
  # state file's presence. In practice this rarely fires: hos-suspend blocks
  # the *next* cycle from ever reaching claude again until a human clears the
  # suspend marker, so the ordinary path is a human closing the issue by hand
  # when they clear it. This covers the case where the marker was cleared
  # directly without also closing the issue.
  if [[ -n "${_REPO_SLUG:-}" ]]; then
    if _ul_open_nums=$(gh api "repos/${_REPO_SLUG}/issues?state=open&labels=needs-human&per_page=20" \
        --jq "[.[] | select(.title | startswith(\"${_USAGE_LIMIT_BREAKER_TITLE_PREFIX}\"))] | .[].number" \
        2>/dev/null); then
      while IFS= read -r _ul_num; do
        [[ -z "$_ul_num" ]] && continue
        gh issue close "$_ul_num" --repo "$_REPO_SLUG" \
          --comment "Cycle completed normally — auto-closing the usage-limit-breaker issue." \
          2>/dev/null && echo "$LOG_PREFIX auto-closed usage-limit-breaker issue #${_ul_num}" \
          || echo "$LOG_PREFIX WARN: failed to auto-close usage-limit-breaker issue #${_ul_num}"
      done <<< "$_ul_open_nums"
    fi
  fi
  date +%s > "$_LAST_RUN_FILE"
  # If work was done this cycle, drop a self-wakeup for traceability (#1196 kept
  # the wakeup mechanism after removing the idle backoff it used to bypass).
  _did_work=0
  if [[ -n "${_REPO_SLUG:-}" && -n "${HOS_BOT_LOGIN:-}" ]]; then
    _run_start_iso=$(python3 -c "
import datetime, sys
print(datetime.datetime.fromtimestamp(int(sys.argv[1]), tz=datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'))
" "$_run_start_epoch" 2>/dev/null || echo "")
    if [[ -n "$_run_start_iso" ]]; then
      if [[ "$ROLE" == "worker" ]]; then
        _new_prs=$(gh api "repos/${_REPO_SLUG}/pulls?state=all&sort=created&direction=desc&per_page=10" \
          --jq "[.[] | select(.user.login == \"$HOS_BOT_LOGIN\" and .created_at >= \"$_run_start_iso\")] | length" \
          2>/dev/null || echo "0")
        [[ "${_new_prs:-0}" -gt 0 ]] && _did_work=1
      elif [[ "$ROLE" == "overseer" ]]; then
        _merged=$(gh api "repos/${_REPO_SLUG}/pulls?state=closed&sort=updated&direction=desc&per_page=10" \
          --jq "[.[] | select(.merged_by.login == \"$HOS_BOT_LOGIN\" and .merged_at != null and .merged_at >= \"$_run_start_iso\")] | length" \
          2>/dev/null || echo "0")
        [[ "${_merged:-0}" -gt 0 ]] && _did_work=1
      fi
    fi
  fi
  if [[ "$_did_work" -eq 1 ]]; then
    printf '{"reason":"self-wakeup-more-work","project":"%s","timestamp":"%s"}\n' \
      "$PROJECT" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$_WAKEUP_FILE"
    echo "$LOG_PREFIX outcome: did-work — self-wakeup dropped"
  else
    echo "$LOG_PREFIX outcome: idle"
  fi
fi
_sync_audit_logs "$REPO_ROOT"

# Signal the other agent
if [[ "$ROLE" == "worker" ]]; then
  _other="overseer"
else
  _other="worker"
fi
printf '{"reason":"%s-cycle-complete","project":"%s","timestamp":"%s"}\n' \
  "$ROLE" "$PROJECT" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
  > "$_HOS_DIR/wakeup/${_other}-${PROJECT}"
echo "$LOG_PREFIX cycle complete (exit=$_claude_exit) — ${_other} wakeup signal dropped"
