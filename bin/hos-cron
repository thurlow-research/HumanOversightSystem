#!/usr/bin/env bash
# bin/hos-cron — parameterized HOS cron launcher
#
# Single entry point for all HOS cron agents. Replace per-agent crontab entries
# with this wrapper so fixes propagate to all projects automatically.
#
# Usage:
#   hos-cron --role worker|overseer --project <name> [--max-seconds <N>]
#
# Project registry: ~/.config/hos/projects.conf
#   hos_config_dir=$HOME/Code/HOS/.config/hos
#   hos_worker_root=$HOME/Code/HOS/Worker
#   hos_overseer_root=$HOME/Code/HOS/Overseer
#   cps_config_dir=$HOME/Code/CPS/.config/hos
#   cps_worker_root=$HOME/Code/CPS/Main
#   cps_overseer_root=$HOME/Code/CPS/Main
#   cps_baseline_on_red=halt     # optional (#1496); default "repair" — see below
#   cps_max_seconds=3600         # optional (#1434); default 1800 — see below
#   cps_worktree_hygiene=preserve  # optional (#1415); default "off" — see below
#
# Claude auth (#728): ~/.config/hos/claude-auth.env  (mode 0600), holding
#   CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...   (from `claude setup-token`)
# This runs headless claude on the user's Claude subscription. Without it, cron falls
# through to API-key billing. Override path with HOS_CLAUDE_AUTH_ENV.
#
# Session timeout (#1434): the wall-clock cap on the claude session is resolved
# in this order, highest wins — a non-numeric value from any source fails
# loudly and names the offending source, rather than silently falling back:
#   --max-seconds <N>                 (highest)
#   HOS_CRON_MAX_SECONDS env
#   <project>_max_seconds in projects.conf
#   1800 default                      (lowest)
# `0` disables the cap at any tier. The default stays 1800 deliberately — see
# the "Explicit non-goal" section of #1434; use the flag for runs known to be
# large, not a blanket raise.
#
# Env overrides:
#   HOS_CLAUDE_AUTH_ENV         path to the OAuth token file (default ~/.config/hos/claude-auth.env)
#   HOS_CRON_MAX_SECONDS        wall-clock cap on the claude session (default 1800; 0 disables) — see precedence above
#   HOS_CRON_MAX_TURNS          optional --max-turns backstop (default unset = no cap)
#   HOS_CRON_AUTH_PROBE         1 = run a model auth probe before work (default 0; costs a turn)
#   HOS_CRON_JITTER_MAX         max startup jitter in seconds (default 60; 0 disables)
#   HOS_TARGET_RELEASE          override the active release title (e.g. v0.4.2); default from projects.conf
#   HOS_TARGET_MILESTONE_NUMBER override the milestone number directly (skips REST resolution)
#   HOS_BASELINE_REPAIR_MAX_ATTEMPTS  consecutive red-baseline cycles allowed
#                               (default mode, #1496) before escalating to needs-human (default 3)
#   HOS_TIMEOUT_BREAKER_MAX_ATTEMPTS  consecutive exit=124 cycles at an unchanged
#                               cap before the project is suspended via hos-suspend
#                               (default 2; #1435)
#   HOS_WORKTREE_HYGIENE        override <project>_worktree_hygiene (off|preserve)
#   HOS_WORKTREE_HYGIENE_MAX_BYTES  quarantine size ceiling in bytes before hygiene
#                               refuses to sweep (default 268435456 = 256 MiB)
#
# <project>_worktree_hygiene (projects.conf, worker only; #1415): a dead cycle
# can leave debris (untracked scratch files, uncommitted edits to tracked files)
# in the worktree that fails the cycle-start baseline for every subsequent
# cycle until a human intervenes. "off" (default) is a no-op — unchanged legacy
# behavior. "preserve" runs a pre-baseline sweep that copies every uncommitted
# path to a timestamped quarantine dir under $HOS_STATE_DIR/worktree-quarantine
# (with a MANIFEST + RESTORE.md), verifies the copy byte-for-byte, THEN reverts
# tracked files to HEAD and removes untracked ones — nothing is ever deleted
# before it is safely copied elsewhere and verified. Refuses (leaves the tree
# untouched, warns, and lets the baseline run as before) on an in-progress git
# operation (merge/rebase/cherry-pick), a size ceiling breach, or any copy/
# verify failure. The broken-state escalation issue (below) is annotated with
# whether the tree was verified clean when the baseline still failed (genuine
# breakage) or hygiene itself failed (the red baseline may be leftover debris,
# not a regression) — never silent either way. Opt-in default reflects a real
# incident: an earlier, less careful draft of this mechanism reverted tracked
# files without first saving a patch and destroyed uncommitted work outright
# (2026-09-01, see docs/v0.7.0/ADR-1415-worktree-hygiene.md).
#
# #1498 (worker only, always on, no config): two follow-up mechanisms this
# hygiene sweep deliberately left out of scope. (1) Baseline retry backoff —
# a red cycle-start baseline records HEAD + a `git status --porcelain`
# fingerprint + its exit code at $_HOS_DIR/baseline-red/<role>-<project>; the
# next cycle skips re-running the ~2-3 min suite entirely when both match the
# recorded failure exactly, reusing the recorded exit code so halt/repair-mode
# classification and dedup'd issue filing behave identically to a fresh run —
# any change to HEAD or the worktree invalidates the cache, and a green
# baseline clears it. (2) Stranded zero-commit branch reap — every worker
# cycle, after the #1044 return-to-main check, walks the branch-ownership
# store (bootstrap/lib/branch_ownership.sh) and deletes any LOCAL branch that
# is exactly zero commits ahead of main (a dead cycle that crashed before its
# first commit), skipping the currently checked-out branch and anything with
# commits. Both are best-effort and non-fatal to the cycle.
#
# Usage-limit breaker (#1446): a genuine Claude usage-limit refusal detected in
# the session's own captured output (see $_HOS_DIR/last-claude-output/) trips
# the project into suspension via hos-suspend on the FIRST detection — no
# attempt counter, unlike the timeout breaker above. v1 is reactive-only: no
# sanctioned credential can read `/usage` percentages headlessly (see the
# issue), so this only watches for the CLI's own refusal text.
#
# <project>_baseline_on_red (projects.conf, worker only; #959, default flipped by
# #1496): on a red cycle-start baseline whose failure is an ordinary assertion
# failure (pytest exit 1), "repair" (default) files/reuses a [BLOCKED] issue as
# needs-ai,priority:critical (never needs-human) and lets it flow through the
# normal Step 2 candidate selection — the worker diagnoses and fixes the root
# cause (test or code, any surface) through the normal build/PR/review pipeline
# instead of halting. Bounded by HOS_BASELINE_REPAIR_MAX_ATTEMPTS consecutive
# cycles without reaching green, after which the issue is relabeled needs-human
# and the cycle halts. Explicit "halt" restores the exact legacy behavior:
# files a needs-human issue and exits immediately, no attempt tracking. A
# collection/session/environmental failure (any other nonzero exit) always
# halts regardless of mode, since the worker cannot fix broken infrastructure.
# Either mode auto-closes a standing [BLOCKED] issue once the baseline goes green.
#
# Crontab example (the wrapper pins its own PATH, so no PATH= prefix is needed):
#   1,6,11,...  * * * *  /path/to/hos-cron --role worker  --project hos >> /tmp/hos-worker-hos.log 2>&1
#   4,9,14,...  * * * *  /path/to/hos-cron --role overseer --project hos >> /tmp/hos-overseer-hos.log 2>&1

set -euo pipefail

# ── Cron thin-env hardening (#728) — build our own world, don't trust cron's ──
# Cron provides a near-empty environment (minimal PATH, no profile sourced), which
# is why a bare `claude` can fail with "command not found". Pin PATH and resolve
# the claude binary by absolute path so the wrapper works from a minimal crontab
# line. Everything derives from $HOME — nothing machine-specific is hardcoded.
if [[ -z "${HOME:-}" ]]; then
  HOME="$(eval echo "~$(id -un)")"; export HOME
fi
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
# nvm-managed node, if present (no-op otherwise)
[[ -s "$HOME/.nvm/nvm.sh" ]] && . "$HOME/.nvm/nvm.sh"
# Resolve claude by absolute path — never depend on a partial cron PATH
CLAUDE_BIN="$(command -v claude || true)"
[[ -n "$CLAUDE_BIN" ]] || { echo "[hos-cron] FATAL: claude not found on PATH (cron thin env)"; exit 78; }

# Deterministic git credentials (#738) — sourced now, applied after auth below.
# #957: a checkout that missed an upgrade applied to a sibling role (e.g.
# Overseer stuck on v0.4.1 while Worker moved to v0.5.0) has this file
# missing outright, and a raw `source` under `set -e` crash-loops with a bare
# "No such file" before the self-sync later in this script ever runs — the
# staleness that breaks it also blocks the self-heal. Guard it: attempt a
# fetch + fast-forward of this checkout first, then degrade to a clear
# diagnostic instead of a silent crash-loop.
_HOS_CRON_DIR="$(dirname "${BASH_SOURCE[0]}")"
_GIT_CREDS_LIB="$_HOS_CRON_DIR/lib/git-credentials.sh"
_HOS_CRON_SELF_ROOT="$(cd "$_HOS_CRON_DIR/.." && pwd)"
if [[ ! -f "$_GIT_CREDS_LIB" ]]; then
  echo "[hos-cron] WARNING: $_GIT_CREDS_LIB missing (stale checkout? #957) — attempting self-update" >&2
  git -C "$_HOS_CRON_SELF_ROOT" fetch origin --quiet 2>/dev/null || true
  git -C "$_HOS_CRON_SELF_ROOT" merge --ff-only --quiet origin/main 2>/dev/null || true
fi
if [[ ! -f "$_GIT_CREDS_LIB" ]]; then
  echo "[hos-cron] FATAL: $_GIT_CREDS_LIB still missing after self-update attempt — checkout is stale and cannot self-heal; run: git -C \"$_HOS_CRON_SELF_ROOT\" pull --ff-only origin main" >&2
  exit 78  # EX_CONFIG
fi
# shellcheck source=lib/git-credentials.sh
source "$_GIT_CREDS_LIB"

# ── Args ─────────────────────────────────────────────────────────────────────
ROLE="" PROJECT="" _MAX_SECONDS_FLAG=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --role)         ROLE="$2";            shift 2 ;;
    --project)      PROJECT="$2";         shift 2 ;;
    --max-seconds)  _MAX_SECONDS_FLAG="$2"; shift 2 ;;
    *) echo "Usage: $0 --role worker|overseer --project <name> [--max-seconds <N>]"; exit 1 ;;
  esac
done
[[ -n "$ROLE" && -n "$PROJECT" ]] \
  || { echo "hos-cron: --role and --project required"; exit 1; }
[[ "$ROLE" == "worker" || "$ROLE" == "overseer" ]] \
  || { echo "hos-cron: --role must be worker or overseer"; exit 1; }

# ── Project registry ─────────────────────────────────────────────────────────
PROJECTS_CONF="${HOME}/.config/hos/projects.conf"
_conf_val() {
  local key="${PROJECT}_${1}"
  [[ -f "$PROJECTS_CONF" ]] \
    && grep "^${key}=" "$PROJECTS_CONF" | head -1 | cut -d= -f2- \
    || echo ""
}

HOS_CONFIG_DIR="$(_conf_val config_dir)"
REPO_ROOT="$(_conf_val ${ROLE}_root)"

[[ -n "$HOS_CONFIG_DIR" ]] \
  || { echo "hos-cron: no ${PROJECT}_config_dir in $PROJECTS_CONF"; exit 1; }
[[ -n "$REPO_ROOT" ]] \
  || { echo "hos-cron: no ${PROJECT}_${ROLE}_root in $PROJECTS_CONF"; exit 1; }

export HOS_CONFIG_DIR REPO_ROOT

# ── Session timeout resolution (#1434) ────────────────────────────────────────
# Precedence: --max-seconds flag > HOS_CRON_MAX_SECONDS env > <project>_max_seconds
# in projects.conf > 1800 default. Resolved here — before the overlap lock below
# derives its ceiling from HOS_CRON_MAX_SECONDS, and before the per-fire bounds
# section reads it again — so both follow this resolution automatically. A
# non-numeric value from any source fails loudly and names the offending
# source, rather than silently falling back to the default (the #1398
# anti-pattern this deliberately avoids).
if [[ -n "$_MAX_SECONDS_FLAG" ]]; then
  _max_secs_val="$_MAX_SECONDS_FLAG"
  _max_secs_src="--max-seconds flag"
elif [[ -n "${HOS_CRON_MAX_SECONDS:-}" ]]; then
  _max_secs_val="$HOS_CRON_MAX_SECONDS"
  _max_secs_src="HOS_CRON_MAX_SECONDS env"
else
  _max_secs_val="$(_conf_val max_seconds)"
  if [[ -n "$_max_secs_val" ]]; then
    _max_secs_src="${PROJECT}_max_seconds in $PROJECTS_CONF"
  else
    _max_secs_val="1800"
    _max_secs_src="default"
  fi
fi
[[ "$_max_secs_val" =~ ^[0-9]+$ ]] \
  || { echo "hos-cron: invalid max-seconds value '$_max_secs_val' from $_max_secs_src — must be a non-negative integer"; exit 1; }
HOS_CRON_MAX_SECONDS="$_max_secs_val"
export HOS_CRON_MAX_SECONDS

# #1435: shared title prefix for the timeout-breaker's needs-human issue —
# defined once here so both the trip path (exit=124 handling) and the clear
# path (normal-completion bookkeeping) match the same issue.
_TIMEOUT_BREAKER_TITLE_PREFIX="[SUSPENDED] ${ROLE} timeout breaker tripped on ${PROJECT}"
# #1446: shared title prefix for the usage-limit breaker's needs-human issue —
# same reason as above, one definition for both the trip path and the
# normal-completion auto-close path.
_USAGE_LIMIT_BREAKER_TITLE_PREFIX="[SUSPENDED] ${ROLE} usage-limit breaker tripped on ${PROJECT}"

# ── Worktree hygiene mode (#1415) ────────────────────────────────────────────
# Precedence: HOS_WORKTREE_HYGIENE env > <project>_worktree_hygiene > off
_HYGIENE_MODE="${HOS_WORKTREE_HYGIENE:-$(_conf_val worktree_hygiene)}"
_HYGIENE_MODE="${_HYGIENE_MODE:-off}"
_HYGIENE_CONF_INVALID=""
case "$_HYGIENE_MODE" in
  off|preserve) ;;
  *) _HYGIENE_CONF_INVALID="$_HYGIENE_MODE"; _HYGIENE_MODE="off" ;;
esac
_HYGIENE_RESULT="disabled"      # disabled|nothing_to_sweep|swept|failed
_HYGIENE_REASON=""              # set only when result=failed
_HYGIENE_COUNT=0
_HYGIENE_QUARANTINE=""
_HYGIENE_BASE_SHA=""
_HYGIENE_RESIDUAL=""
_HYGIENE_MAX_BYTES="${HOS_WORKTREE_HYGIENE_MAX_BYTES:-268435456}"   # 256 MiB

LOG_PREFIX="[hos-${ROLE}-cron:${PROJECT}] $(date -u '+%Y-%m-%dT%H:%M:%SZ')"

# ── State dirs ────────────────────────────────────────────────────────────────
_HOS_DIR="${HOS_STATE_DIR:-${HOME}/.hos}"
# #995: wakeup files are scoped per-project (mirroring last-run) so one project's
# cron can no longer consume — and rm — another project's wakeup signal. The
# legacy unscoped path is still read (only) for backward compatibility with
# signals dropped by an older launcher; see the consume block below.
_WAKEUP_FILE="$_HOS_DIR/wakeup/${ROLE}-${PROJECT}"
_WAKEUP_FILE_LEGACY="$_HOS_DIR/wakeup/${ROLE}"
_LAST_RUN_FILE="$_HOS_DIR/last-run/${ROLE}-${PROJECT}"
mkdir -p "$_HOS_DIR/wakeup" "$_HOS_DIR/last-run" "$_HOS_DIR/locks" "$_HOS_DIR/validation-cache" "$_HOS_DIR/suspend" "$_HOS_DIR/test-clean" "$_HOS_DIR/timeout-breaker" "$_HOS_DIR/last-claude-output"
_HOS_CACHE_DIR="$_HOS_DIR/validation-cache"

# ── Project suspension check (#778) — early exit before lock ─────────────────
# bin/hos-suspend writes a JSON marker to $_HOS_DIR/suspend/<project>. When
# present, skip this cycle cleanly. An optional "until" field auto-expires the
# marker: remove it on the first fire after the expiration date so cron resumes
# automatically without needing a manual --clear.
_SUSPEND_FILE="$_HOS_DIR/suspend/$PROJECT"
if [[ -f "$_SUSPEND_FILE" ]]; then
  _until=$(python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(d.get('until', ''))
except Exception:
    print('')
" "$_SUSPEND_FILE" 2>/dev/null || echo "")
  if [[ -n "$_until" ]]; then
    _today=$(date -u '+%Y-%m-%d')
    if [[ "$_today" > "$_until" ]]; then
      rm -f "$_SUSPEND_FILE"
      echo "$LOG_PREFIX suspension expired (was until $_until) — resuming"
    else
      echo "$LOG_PREFIX [SUSPENDED] project $PROJECT suspended until $_until (use: hos-suspend --project $PROJECT --clear)"
      exit 0
    fi
  else
    echo "$LOG_PREFIX [SUSPENDED] project $PROJECT suspended indefinitely (use: hos-suspend --project $PROJECT --clear)"
    exit 0
  fi
fi

# ── Overlap lock (#728, #1002) — portable mkdir mutex (macOS has no flock) ───
# One hos-cron run per (role, project) at a time. Lightweight overlap guard,
# not the orchestrator machine-lock.
#
# `mkdir` and `echo $$ >pid` are two separate steps, so reclaim must guard two
# fail modes the naive "reclaim unless the recorded PID is alive" logic hit:
#   (a) Empty-pid double-acquire (#1002): a contender that loses the mkdir race
#       but reads the pid file before the holder has written it sees "". That is
#       "holder in-flight" — it must back off, NOT treat the lock as stale and
#       reclaim it (which rm's the live lock and lets both sessions run).
#   (b) PID-reuse permanent standstill (#1002): after a reboot mid-cycle the
#       recorded PID can be reused by any long-lived same-user process, so
#       `kill -0` succeeds forever and every cycle exits 0 as "locked" while the
#       role is dead indefinitely. A lock-age ceiling reclaims regardless of PID
#       liveness, bounding any standstill — and also frees an in-flight lock
#       whose holder died before recording its pid.
_LOCK_DIR="$_HOS_DIR/locks/hos-cron-${ROLE}-${PROJECT}.lock"
_stat_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }
# Ceiling = 2x the session cap, floored at 1h so a disabled (0) or tiny cap can
# never collapse the ceiling to ~0 and turn every lock into an instant reclaim.
_lock_max_secs="${HOS_CRON_MAX_SECONDS:-1800}"
[[ "$_lock_max_secs" =~ ^[0-9]+$ ]] || _lock_max_secs=1800
_lock_ceiling=$(( _lock_max_secs * 2 ))
(( _lock_ceiling >= 3600 )) || _lock_ceiling=3600
if ! mkdir "$_LOCK_DIR" 2>/dev/null; then
  _lock_pid="$(cat "$_LOCK_DIR/pid" 2>/dev/null || echo "")"
  _lock_age=$(( $(date +%s) - $(_stat_mtime "$_LOCK_DIR") ))
  if (( _lock_age >= _lock_ceiling )); then
    echo "$LOG_PREFIX reclaiming stale lock (age ${_lock_age}s ≥ ${_lock_ceiling}s ceiling, holder pid=${_lock_pid:-unknown})"
    rm -rf "$_LOCK_DIR"
    mkdir "$_LOCK_DIR" 2>/dev/null || { echo "$LOG_PREFIX could not acquire lock after reclaim — exiting"; exit 0; }
  elif [[ -z "$_lock_pid" ]]; then
    echo "$LOG_PREFIX another hos-cron $ROLE:$PROJECT run is acquiring the lock (pid not yet recorded) — exiting"
    exit 0
  elif kill -0 "$_lock_pid" 2>/dev/null; then
    echo "$LOG_PREFIX another hos-cron $ROLE:$PROJECT run (pid=$_lock_pid) holds the lock — exiting"
    exit 0
  else
    echo "$LOG_PREFIX reclaiming stale lock (holder pid=$_lock_pid not alive)"
    rm -rf "$_LOCK_DIR"
    mkdir "$_LOCK_DIR" 2>/dev/null || { echo "$LOG_PREFIX could not acquire lock after reclaim — exiting"; exit 0; }
  fi
fi
echo "$$" > "$_LOCK_DIR/pid"
trap 'rm -rf "$_LOCK_DIR" 2>/dev/null || true' EXIT

# ── Cycle identity (#967, ADR-037 AD-5) ───────────────────────────────────────
# Minted exactly once per invocation, under the overlap lock, and exported into
# the launched Claude session's environment. This is the ONLY place cycle
# identity is minted — nothing downstream may derive, invent, or persist one.
# Its ABSENCE is the fail-closed hinge for branch-ownership enforcement
# (bootstrap/lib/branch_ownership.sh, bootstrap/submit_pr.sh): an interactive
# session is never launched by this script, so it never has a cycle id, so it
# can never write or satisfy a valid ownership record — role-scoping falls out
# of the minting boundary with no separate role-detection heuristic needed.
_cycle_ts="$(date -u +%y%m%d%H%M%S)"          # 12 digits, e.g. 260802191500
HOS_CYCLE_TOKEN="$_cycle_ts"
HOS_CYCLE_ROLE="$ROLE"
# PROJECT is operator-supplied (registry key); sanitize before folding it into
# an identifier so a stray character in projects.conf can't produce a cycle id
# that fails its own grammar check below.
_project_safe="$(printf '%s' "$PROJECT" | tr -c 'A-Za-z0-9._-' '-')"
HOS_CYCLE_ID="${ROLE}-${_project_safe}-${_cycle_ts}-$$"
if [[ ! "$HOS_CYCLE_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "$LOG_PREFIX FATAL: minted HOS_CYCLE_ID '$HOS_CYCLE_ID' failed grammar validation — refusing to launch a session with a malformed cycle identity"
  exit 78  # EX_CONFIG
fi
# Minted for BOTH roles (#967 ADR-037 AD-5) — the overseer creates no branches,
# but giving it an identity costs nothing and keeps one code path; role scoping
# is enforced by the recorded role= value in the ownership record, not by
# withholding the identifier here.
export HOS_CYCLE_ID HOS_CYCLE_ROLE HOS_CYCLE_TOKEN

# ── Audit helper ──────────────────────────────────────────────────────────────
_audit() {
  local event="$1"; shift
  (cd "$REPO_ROOT" && python3 -m scripts.automation.lib.cycle_log "$event" "$@") 2>/dev/null || true
}

# ── Audit log sync (#861, updated #1303) ──────────────────────────────────────
# Push per-entry audit records under audit/log/**/*.json (write-once,
# content-addressed filenames — #888 retired the single-file
# audit/oversight-log.jsonl this used to target) and audit/overnight-loop-log.md
# to the unprotected `audit-log` branch. A GitHub Actions workflow reads from
# that branch and commits only those files to main, keeping feature PRs free of
# append-only conflicts while maintaining an auditable sync path.
_sync_audit_logs() {
  local _repo="$1"
  local _files=()
  local _f
  while IFS= read -r -d '' _f; do
    _files+=("${_f#"$_repo"/}")
  done < <(find "$_repo/audit/log" -type f -name '*.json' -print0 2>/dev/null)
  [[ -f "$_repo/audit/overnight-loop-log.md" ]] && _files+=("audit/overnight-loop-log.md")
  [[ ${#_files[@]} -eq 0 ]] && return 0

  (
    cd "$_repo" || return 0
    git fetch origin audit-log main --quiet 2>/dev/null || git fetch origin main --quiet 2>/dev/null || return 0
    local _base
    git ls-remote --exit-code origin audit-log &>/dev/null \
      && _base="origin/audit-log" || _base="origin/main"

    # Sync in a throwaway *detached* worktree, never by switching the live
    # checkout's branch (#988). The old `git checkout -b _audit-sync-$$` ran in
    # $REPO_ROOT itself, so a SIGKILL (sleep/reboot/OOM) between `checkout -b`
    # and `checkout -` — or a masked `checkout -` failure — stranded the shared
    # working tree on an audit-log branch, and the next cycle then built/pushed
    # feature work off audit-log history. A separate worktree keeps the live
    # HEAD, branch and index untouched no matter when we die; worst case a
    # scratch dir is left under TMPDIR, reaped by `git worktree prune` next run.
    git worktree prune 2>/dev/null || true
    local _scratch _wt
    _scratch="$(mktemp -d "${TMPDIR:-/tmp}/hos-audit-sync.XXXXXX")" || return 0
    _wt="$_scratch/wt"
    # Subshell-local EXIT trap: fires on normal return AND on interruption, and
    # does not disturb the parent's lock-cleanup trap.
    trap 'git -C "$_repo" worktree remove --force "$_wt" 2>/dev/null || true; rm -rf "$_scratch" 2>/dev/null || true' EXIT
    git worktree add --detach --quiet "$_wt" "$_base" 2>/dev/null || return 0

    local _changed=0
    for _f in "${_files[@]}"; do
      # Write-once, content-addressed filenames: a file already present at this
      # path on the base is identical by construction, so skip it rather than
      # re-copy/re-hash it every cycle (the backlog is thousands of files deep).
      [[ -e "$_wt/$_f" ]] && continue
      mkdir -p "$_wt/$(dirname "$_f")" 2>/dev/null || true
      cp -f "$_repo/$_f" "$_wt/$_f" 2>/dev/null || continue
      git -C "$_wt" add -f "$_f" 2>/dev/null
      git -C "$_wt" diff --cached --quiet "$_f" 2>/dev/null || _changed=1
    done
    if [[ "$_changed" -eq 1 ]]; then
      git -C "$_wt" commit -m "chore(audit): sync logs $(date -u '+%Y-%m-%dT%H:%M:%SZ')" --quiet
      git -C "$_wt" push origin HEAD:refs/heads/audit-log --quiet 2>/dev/null \
        && echo "$LOG_PREFIX audit logs pushed to audit-log branch" \
        || echo "$LOG_PREFIX WARN: audit-log push failed (will retry next cycle)"
    fi
    # EXIT trap removes the scratch worktree; the live checkout is never touched.
  )
}

# ── Worktree hygiene (#1415) ──────────────────────────────────────────────────
# Filesystem quarantine (copy → verify → remove) of debris left by a dead
# cycle — untracked scratch files and uncommitted tracked-file edits — so a
# stale worktree can no longer defeat the #1044 return-to-main check or the
# #1393 ff-only guard. Opt-in via <project>_worktree_hygiene=preserve; a
# no-op otherwise (default off, unchanged behavior). Nothing is ever deleted
# before it is copied elsewhere and verified byte-for-byte; no git
# stash/reset/clean, no ref manipulation anywhere. See
# docs/v0.7.0/ADR-1415-worktree-hygiene.md for the full design rationale.
_HY_EXCLUDE_PATHSPEC=':(exclude)audit'

_stat_size() { stat -c %s "$1" 2>/dev/null || stat -f %z "$1" 2>/dev/null || echo 0; }

_hy_mode_desc() {
  # symlink | octal permission bits | unpreserved (stat failed outright)
  if [[ -L "$1" ]]; then
    echo "symlink"
  else
    stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1" 2>/dev/null || echo "unpreserved"
  fi
}

_worktree_hygiene_fail() {
  # Sets result=failed + reason, warns, audits — and always returns 0. Never
  # removes anything and never exits the cycle; the caller returns right
  # after calling this.
  local _reason="$1"; shift
  _HYGIENE_RESULT="failed"
  _HYGIENE_REASON="$_reason"
  echo "$LOG_PREFIX WARN: worktree hygiene failed (${_reason}) — leaving the worktree as-is (#1415)"
  _audit cycle-worktree-hygiene-fail "reason=${_reason}" "residual=${_HYGIENE_RESIDUAL}" "$@"
}

_worktree_hygiene() {
  # ── Step 0: config diagnostics — always evaluated, independent of role/mode ──
  if [[ -n "$_HYGIENE_CONF_INVALID" ]]; then
    echo "$LOG_PREFIX WARN: unrecognized worktree_hygiene value '${_HYGIENE_CONF_INVALID}' — treating as off (#1415)"
    _audit cycle-hygiene-config-invalid "value=${_HYGIENE_CONF_INVALID}"
  fi
  if [[ ! "$_HYGIENE_MAX_BYTES" =~ ^[0-9]+$ ]]; then
    local _hy_bad_bytes="$_HYGIENE_MAX_BYTES"
    _HYGIENE_MAX_BYTES=268435456
    echo "$LOG_PREFIX WARN: non-numeric HOS_WORKTREE_HYGIENE_MAX_BYTES value '${_hy_bad_bytes}' — falling back to 256 MiB default (#1415)"
    _audit cycle-hygiene-config-invalid "value=${_hy_bad_bytes}" "key=max_bytes"
  fi

  # ── Step 1: applicability gates — any true leaves result=disabled, removes nothing ──
  [[ "$ROLE" == "worker" ]] || return 0
  [[ "$_HYGIENE_MODE" == "preserve" ]] || return 0
  git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1 || return 0
  if ! git -C "$REPO_ROOT" rev-parse --verify HEAD >/dev/null 2>&1; then
    echo "$LOG_PREFIX worktree hygiene skipped — HEAD unresolvable (#1415)"
    return 0
  fi
  _HYGIENE_BASE_SHA="$(git -C "$REPO_ROOT" rev-parse HEAD)"

  # ── Step 2: refuse during an in-progress git operation ───────────────────
  local _hy_gd
  _hy_gd="$(git -C "$REPO_ROOT" rev-parse --git-dir 2>/dev/null)"
  case "$_hy_gd" in
    /*) ;;
    *) _hy_gd="$REPO_ROOT/$_hy_gd" ;;
  esac
  if [[ -e "$_hy_gd/MERGE_HEAD" || -e "$_hy_gd/CHERRY_PICK_HEAD" || -e "$_hy_gd/REVERT_HEAD" \
        || -e "$_hy_gd/rebase-merge" || -e "$_hy_gd/rebase-apply" ]]; then
    _worktree_hygiene_fail operation_in_progress
    return 0
  fi

  # ── Step 3: enumerate (never --ignored) ───────────────────────────────────
  local -a _hy_untracked_path=() _hy_untracked_xy=() _hy_tracked_path=() _hy_tracked_xy=()
  local _hy_rec _hy_xy _hy_path _hy_orig
  while IFS= read -r -d '' _hy_rec; do
    _hy_xy="${_hy_rec:0:2}"
    _hy_path="${_hy_rec:3}"
    if [[ "$_hy_xy" == "??" ]]; then
      [[ "$_hy_path" == audit/* || "$_hy_path" == "audit" ]] && continue
      _hy_untracked_xy+=("$_hy_xy")
      _hy_untracked_path+=("$_hy_path")
      continue
    fi
    if [[ "$_hy_xy" == *U* || "$_hy_xy" == "AA" || "$_hy_xy" == "DD" ]]; then
      _worktree_hygiene_fail unmerged_paths
      return 0
    fi
    if [[ "${_hy_xy:0:1}" == "R" || "${_hy_xy:0:1}" == "C" ]]; then
      IFS= read -r -d '' _hy_orig || true
    fi
    [[ "$_hy_path" == audit/* || "$_hy_path" == "audit" ]] && continue
    _hy_tracked_xy+=("$_hy_xy")
    _hy_tracked_path+=("$_hy_path")
  done < <(git -C "$REPO_ROOT" status --porcelain -uall -z 2>/dev/null)

  if [[ ${#_hy_untracked_path[@]} -eq 0 && ${#_hy_tracked_path[@]} -eq 0 ]]; then
    _HYGIENE_RESULT="nothing_to_sweep"
    return 0
  fi

  # ── Step 4: size ceiling — before any copy ────────────────────────────────
  local _hy_bytes=0 _hy_i _hy_untracked_bytes=0
  for ((_hy_i = 0; _hy_i < ${#_hy_untracked_path[@]}; _hy_i++)); do
    _hy_untracked_bytes=$(( _hy_untracked_bytes + $(_stat_size "$REPO_ROOT/${_hy_untracked_path[_hy_i]}") ))
  done
  local _hy_diff_bytes
  _hy_diff_bytes=$(git -C "$REPO_ROOT" diff --binary HEAD -- . "$_HY_EXCLUDE_PATHSPEC" 2>/dev/null | wc -c)
  _hy_bytes=$(( _hy_untracked_bytes + _hy_diff_bytes ))
  if (( _hy_bytes > _HYGIENE_MAX_BYTES )); then
    _worktree_hygiene_fail size_ceiling_exceeded "bytes=${_hy_bytes}" "ceiling=${_HYGIENE_MAX_BYTES}"
    return 0
  fi

  # ── Step 5: create quarantine (copy phase) ────────────────────────────────
  local _hy_ts _hy_q
  _hy_ts="$(date -u +%Y%m%dT%H%M%SZ)"
  _hy_q="$_HOS_DIR/worktree-quarantine/${ROLE}-${PROJECT}/${_hy_ts}-${HOS_CYCLE_ID}"
  if ! mkdir -p "$_hy_q/untracked"; then
    _worktree_hygiene_fail quarantine_mkdir_failed
    return 0
  fi
  _HYGIENE_QUARANTINE="$_hy_q"

  git -C "$REPO_ROOT" diff --binary HEAD -- . "$_HY_EXCLUDE_PATHSPEC" > "$_hy_q/tracked.patch" 2>/dev/null

  local _hy_copy_failed=0
  for ((_hy_i = 0; _hy_i < ${#_hy_untracked_path[@]}; _hy_i++)); do
    _hy_path="${_hy_untracked_path[_hy_i]}"
    if ! mkdir -p "$_hy_q/untracked/$(dirname "$_hy_path")" 2>/dev/null; then
      _hy_copy_failed=1; break
    fi
    if ! cp -a -- "$REPO_ROOT/$_hy_path" "$_hy_q/untracked/$_hy_path" 2>/dev/null; then
      _hy_copy_failed=1; break
    fi
  done
  if [[ "$_hy_copy_failed" -eq 1 ]]; then
    _worktree_hygiene_fail copy_failed
    return 0
  fi

  local _hy_branch
  _hy_branch="$(git -C "$REPO_ROOT" symbolic-ref --short HEAD 2>/dev/null || echo DETACHED)"
  local _hy_tracked_patch_bytes
  _hy_tracked_patch_bytes="$(_stat_size "$_hy_q/tracked.patch")"
  local _hy_total_bytes=$(( _hy_tracked_patch_bytes + _hy_untracked_bytes ))

  {
    echo "base_sha=${_HYGIENE_BASE_SHA}"
    echo "branch=${_hy_branch}"
    echo "cycle_id=${HOS_CYCLE_ID}"
    echo "utc=${_hy_ts}"
    echo "mode=preserve"
    echo "tracked_patch_bytes=${_hy_tracked_patch_bytes}"
    echo "untracked_bytes=${_hy_untracked_bytes}"
    echo "total_bytes=${_hy_total_bytes}"
    for ((_hy_i = 0; _hy_i < ${#_hy_untracked_path[@]}; _hy_i++)); do
      printf '%s\t%s\t%s\n' "${_hy_untracked_xy[_hy_i]}" "${_hy_untracked_path[_hy_i]}" \
        "$(_hy_mode_desc "$REPO_ROOT/${_hy_untracked_path[_hy_i]}")"
    done
    for ((_hy_i = 0; _hy_i < ${#_hy_tracked_path[@]}; _hy_i++)); do
      printf '%s\t%s\tin:tracked.patch\n' "${_hy_tracked_xy[_hy_i]}" "${_hy_tracked_path[_hy_i]}"
    done
  } > "$_hy_q/MANIFEST.txt"

  cat > "$_hy_q/RESTORE.md" <<RESTORE_EOF
# Recovering quarantined work (#1415)

This directory holds work swept out of $REPO_ROOT by bin/hos-cron's
pre-baseline worktree hygiene at $_hy_ts. Nothing was deleted before it was
copied here and verified. See MANIFEST.txt for the full path list.

Base commit: $_HYGIENE_BASE_SHA   Branch: $_hy_branch   Cycle: $HOS_CYCLE_ID

## Restore everything

    cd $REPO_ROOT
    git checkout $_HYGIENE_BASE_SHA          # or a branch at that commit
    git apply --binary "$_hy_q/tracked.patch"     # skip if 0 bytes
    cp -a "$_hy_q/untracked/." .

## Restore one file

    cp -a "$_hy_q/untracked/<path>" "$REPO_ROOT/<path>"

## Discard

    rm -rf "$_hy_q"
RESTORE_EOF

  # ── Step 6: verify (before any removal) ───────────────────────────────────
  local _hy_verify_ok=1
  [[ -f "$_hy_q/tracked.patch" && -f "$_hy_q/MANIFEST.txt" ]] || _hy_verify_ok=0
  if [[ "$_hy_verify_ok" -eq 1 && -s "$_hy_q/tracked.patch" ]]; then
    git -C "$REPO_ROOT" apply --check --reverse --binary "$_hy_q/tracked.patch" 2>/dev/null \
      || _hy_verify_ok=0
  fi
  if [[ "$_hy_verify_ok" -eq 1 ]]; then
    for ((_hy_i = 0; _hy_i < ${#_hy_untracked_path[@]}; _hy_i++)); do
      _hy_path="${_hy_untracked_path[_hy_i]}"
      if [[ ! -e "$_hy_q/untracked/$_hy_path" && ! -L "$_hy_q/untracked/$_hy_path" ]]; then
        _hy_verify_ok=0; break
      fi
      if [[ "$(_stat_size "$REPO_ROOT/$_hy_path")" != "$(_stat_size "$_hy_q/untracked/$_hy_path")" ]]; then
        _hy_verify_ok=0; break
      fi
    done
  fi
  if [[ "$_hy_verify_ok" -eq 1 ]]; then
    local _hy_qcount
    _hy_qcount="$(find "$_hy_q/untracked" \( -type f -o -type l \) 2>/dev/null | wc -l)"
    [[ "$_hy_qcount" -eq "${#_hy_untracked_path[@]}" ]] || _hy_verify_ok=0
  fi
  if [[ "$_hy_verify_ok" -ne 1 ]]; then
    _worktree_hygiene_fail verify_failed
    return 0
  fi

  # ── Step 7: remove (only after verify passes) ─────────────────────────────
  for ((_hy_i = 0; _hy_i < ${#_hy_tracked_path[@]}; _hy_i++)); do
    _hy_path="${_hy_tracked_path[_hy_i]}"
    if git -C "$REPO_ROOT" cat-file -e "HEAD:$_hy_path" 2>/dev/null; then
      git -C "$REPO_ROOT" checkout HEAD -- "$_hy_path"
    else
      git -C "$REPO_ROOT" rm -q --cached -- "$_hy_path" 2>/dev/null
      rm -f -- "$REPO_ROOT/$_hy_path"
    fi
  done
  for ((_hy_i = 0; _hy_i < ${#_hy_untracked_path[@]}; _hy_i++)); do
    rm -f -- "$REPO_ROOT/${_hy_untracked_path[_hy_i]}"
  done

  # ── Step 8: post-removal residual check ───────────────────────────────────
  local -a _hy_residual=()
  while IFS= read -r -d '' _hy_rec; do
    _hy_xy="${_hy_rec:0:2}"
    _hy_path="${_hy_rec:3}"
    if [[ "${_hy_xy:0:1}" == "R" || "${_hy_xy:0:1}" == "C" ]]; then
      IFS= read -r -d '' _hy_orig || true
    fi
    [[ "$_hy_path" == audit/* || "$_hy_path" == "audit" ]] && continue
    _hy_residual+=("$_hy_path")
  done < <(git -C "$REPO_ROOT" status --porcelain -uall -z 2>/dev/null)

  if [[ ${#_hy_residual[@]} -gt 0 ]]; then
    _HYGIENE_RESIDUAL="${_hy_residual[*]:0:50}"
    _worktree_hygiene_fail residual_dirty
    return 0
  fi

  _HYGIENE_RESULT="swept"
  _HYGIENE_COUNT=$(( ${#_hy_untracked_path[@]} + ${#_hy_tracked_path[@]} ))

  # ── Step 9: report ─────────────────────────────────────────────────────────
  local -a _hy_all_paths=("${_hy_untracked_path[@]}" "${_hy_tracked_path[@]}")
  local _hy_paths_summary
  if [[ ${#_hy_all_paths[@]} -gt 50 ]]; then
    _hy_paths_summary="${_hy_all_paths[*]:0:50} (+$(( ${#_hy_all_paths[@]} - 50 )) more)"
  else
    _hy_paths_summary="${_hy_all_paths[*]}"
  fi
  local _hy_qdirs
  _hy_qdirs="$(find "$_HOS_DIR/worktree-quarantine/${ROLE}-${PROJECT}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)"
  echo "$LOG_PREFIX worktree hygiene: swept ${_HYGIENE_COUNT} path(s) to ${_HYGIENE_QUARANTINE} (#1415)"
  _audit cycle-worktree-hygiene "result=swept" "count=${_HYGIENE_COUNT}" "quarantine=${_HYGIENE_QUARANTINE}" \
    "base_sha=${_HYGIENE_BASE_SHA}" "paths=${_hy_paths_summary}" "quarantine_dirs=${_hy_qdirs}"
  return 0
}

# ── Pre-jitter dependency check (fail-closed, marker-cached) ─────────────────
# Fail fast before the jitter sleep if the oversight venv or pytest are missing.
# A 7-day marker file caches a successful check; its key encodes REPO_ROOT so a
# repo move invalidates it and triggers a re-check automatically.
_pre_jitter_deps_check() {
  local _hash
  if command -v md5sum &>/dev/null; then
    _hash=$(printf '%s' "$REPO_ROOT" | md5sum | cut -d' ' -f1)
  elif command -v md5 &>/dev/null; then
    _hash=$(printf '%s' "$REPO_ROOT" | md5)
  else
    _hash=$(printf '%s' "$REPO_ROOT" | cksum | awk '{print $1}')
  fi
  local _marker="$_HOS_CACHE_DIR/deps-${_hash}"

  if [[ -f "$_marker" ]]; then
    local _now; _now=$(date +%s)
    local _mtime
    if ! _mtime=$(stat -c %Y "$_marker" 2>/dev/null); then
      _mtime=$(stat -f %m "$_marker" 2>/dev/null || echo 0)
    fi
    if [[ $(( _now - _mtime )) -lt 604800 ]]; then
      return 0  # cache hit — skip validation this cycle
    fi
    echo "$LOG_PREFIX deps-cache stale — re-validating environment"
  fi

  local _venv_dir="$REPO_ROOT/scripts/oversight/.venv"
  # A missing/incomplete oversight venv is self-healing: build it via ensure_venv.sh
  # (the same auto-repair _validate_env relies on) and only FATAL if the build itself
  # fails. Bare existence-check-then-FATAL here would shadow that auto-repair (#953).
  if [[ ! -x "$_venv_dir/bin/python" || ! -x "$_venv_dir/bin/pytest" ]]; then
    echo "$LOG_PREFIX oversight venv missing/incomplete at $_venv_dir — building via ensure_venv.sh"
    if ! bash "$REPO_ROOT/scripts/oversight/ensure_venv.sh" --quiet; then
      echo "$LOG_PREFIX FATAL: ensure_venv.sh failed to build oversight venv at $_venv_dir"
      _audit cycle-preflight-fail reason=oversight_venv_build_failed
      exit 78
    fi
  fi

  touch "$_marker" 2>/dev/null || true
}
_pre_jitter_deps_check

# ── Jitter ────────────────────────────────────────────────────────────────────
# Spread concurrent fires so multiple projects don't stampede git/auth at once.
# Override to 0 in tests (and any deterministic context) — mirrors machine_lock's
# HOS_LOCK_JITTER_MAX. Guard the modulo: `% 0` would be a divide-by-zero error.
_JITTER_MAX="${HOS_CRON_JITTER_MAX:-60}"
[[ "$_JITTER_MAX" -gt 0 ]] && sleep $(( RANDOM % _JITTER_MAX ))

# ── Environment validation ("cow patty" markers) ───────────────────────────────
# Check for successful previous setup runs. If markers are missing, log a warning
# but proceed anyway (fail-open). Markers are dropped by hos_bootstrap.sh and
# scripts/oversight/ensure_venv.sh on successful completion.
_validate_env() {
  local missing=0
  [[ -f "$HOME/.hos/setup-validation/bootstrap" ]] \
    || { echo "$LOG_PREFIX ⚠ bootstrap marker missing (run: ./bootstrap/hos_bootstrap.sh)"; missing=1; }
  # Call ensure_venv.sh to verify (and auto-repair) the oversight venv rather than
  # trusting the cached marker alone.  A broken venv (e.g. after a Python upgrade)
  # is detected and rebuilt here so validators can run this cycle.
  if ! bash "$REPO_ROOT/scripts/oversight/ensure_venv.sh" --quiet 2>/dev/null; then
    echo "$LOG_PREFIX ⚠ oversight-venv broken or missing — validators will not run"
    missing=1
  fi
  [[ $missing -eq 0 ]] && echo "$LOG_PREFIX ✓ environment validated"
  return 0  # fail-open: don't block on broken/missing venv
}
_validate_env

# ── Wakeup ────────────────────────────────────────────────────────────────────
# #1196: the idle backoff this mechanism used to bypass is gone (it suppressed
# cron fires to at most once per HOS_IDLE_INTERVAL, based on a GitHub-throttling
# diagnosis later traced to a different cause — see DECISIONS.md). Every cron
# fire now runs the cycle unconditionally, so a wakeup file no longer unblocks
# anything. It is kept anyway: it still hands off role-to-role ("worker just
# opened a PR, overseer should look now" / "overseer just merged, worker can
# proceed") faster than waiting for each role's own next scheduled fire, it
# costs one file write per cycle, and the cycle-wakeup audit event remains a
# useful trace of that coordination. Removing it was considered and rejected —
# see DECISIONS.md.
#
# #995: prefer the project-scoped wakeup file. Fall back to the legacy unscoped
# path ONLY when its JSON "project" field is absent (a truly pre-scoping signal)
# or matches this project — never consume/rm a wakeup that names another project,
# so mixed old/new deployments can't steal each other's signals.
_WAKEUP_ACTIVE=""
if [[ -f "$_WAKEUP_FILE" ]]; then
  _WAKEUP_ACTIVE="$_WAKEUP_FILE"
elif [[ -f "$_WAKEUP_FILE_LEGACY" ]]; then
  _legacy_project=$(python3 -c "
import json, sys
try:
    print(json.load(open(sys.argv[1])).get('project', ''))
except Exception:
    print('')
" "$_WAKEUP_FILE_LEGACY" 2>/dev/null || echo "")
  if [[ -z "$_legacy_project" || "$_legacy_project" == "$PROJECT" ]]; then
    _WAKEUP_ACTIVE="$_WAKEUP_FILE_LEGACY"
  else
    echo "$LOG_PREFIX ignoring legacy wakeup addressed to project '$_legacy_project' (not '$PROJECT') — leaving it for its owner (#995)"
  fi
fi
if [[ -n "$_WAKEUP_ACTIVE" ]]; then
  _wakeup_reason=$(python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(d.get('reason', 'unknown'))
except Exception:
    print('unknown')
" "$_WAKEUP_ACTIVE" 2>/dev/null || echo "unknown")
  rm -f "$_WAKEUP_ACTIVE"
  echo "$LOG_PREFIX wakeup signal received (reason=$_wakeup_reason)"
  _audit cycle-wakeup "reason=$_wakeup_reason"
elif [[ -f "$_LAST_RUN_FILE" ]]; then
  _last=$(cat "$_LAST_RUN_FILE" 2>/dev/null || echo 0)
  _now=$(date +%s)
  _elapsed=$(( _now - _last ))
  echo "$LOG_PREFIX ${_elapsed}s since last run"
fi
# Timestamp written only after successful Claude exit (#711)

# ── Repo slug — shared by halt check, PR routing, and milestone resolution ────
_REPO_SLUG="${HOS_REPO_SLUG:-$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null \
  | sed -E 's|.*github\.com[:/]([^/]+/[^.]+)(\.git)?$|\1|' || echo "")}"

# ── Preflight ─────────────────────────────────────────────────────────────────
export HOS_REQUIRE_PREFLIGHT=1
if ! bash "$REPO_ROOT/bootstrap/validate_setup.sh" --repo "$REPO_ROOT" --quiet 2>/dev/null; then
  echo "$LOG_PREFIX PREFLIGHT FAILED"
  _audit cycle-preflight-fail reason=validate_setup_failed
  exit 0
fi

# ── Auth (tempfile pattern — source <() fails in minimal cron env) ───────────
# #720: mktemp in private dir — shared /tmp exposes token in race window
_auth_tmp=$(mktemp -p "$_HOS_DIR")
if ! "$REPO_ROOT/bootstrap/get_app_token.sh" --app "$ROLE" > "$_auth_tmp" 2>/dev/null; then
  rm -f "$_auth_tmp"
  echo "$LOG_PREFIX AUTH FAILED"
  _audit cycle-preflight-fail reason=auth_failed
  exit 0
fi
# shellcheck source=/dev/null
source "$_auth_tmp"; rm -f "$_auth_tmp"

# ── Identity guard ────────────────────────────────────────────────────────────
if [[ -z "${HOS_EXPECTED_BOT_LOGIN:-}" ]]; then
  echo "$LOG_PREFIX IDENTITY GUARD FAILED: HOS_EXPECTED_BOT_LOGIN not set"
  _audit cycle-preflight-fail reason=identity_guard_unset
  exit 1
fi
if [[ "$HOS_BOT_LOGIN" != "$HOS_EXPECTED_BOT_LOGIN" ]]; then
  echo "$LOG_PREFIX IDENTITY GUARD FAILED: got=$HOS_BOT_LOGIN expected=$HOS_EXPECTED_BOT_LOGIN"
  _audit cycle-preflight-fail reason=identity_guard_mismatch
  exit 1
fi

# ── Deterministic git credentials (#738) ─────────────────────────────────────
# Make `git push` work regardless of the host's credential helper, which is
# interactive-oriented and unreachable from the cron thin-env. Configure the
# already-authenticated `gh` as git's github.com helper for THIS session only —
# no file written, developer's global ~/.gitconfig untouched, and the exported
# env is inherited by the headless claude subprocess (so pushes inside the agent
# need no inline workaround). GH_TOKEN is supplied over gh's stdin protocol, not
# materialized into any URL/argv/file (#734). Must run AFTER auth is sourced so
# gh can authenticate. See bin/lib/git-credentials.sh for the mechanism.
if ! hos_configure_git_credentials; then
  echo "$LOG_PREFIX FATAL: could not configure git credentials (gh not found)"
  _audit cycle-preflight-fail reason=git_credentials_unconfigured
  exit 78  # EX_CONFIG
fi

# ── Claude Code subscription auth (#728) — cron-safe subscription OAuth ──────
# Headless `claude --print` runs on the user's Claude subscription via CLAUDE_CODE_OAUTH_TOKEN.
# Without it, resolution falls through to API-key billing (the keychain credential
# is unreachable from cron). Source the 0600 token file, then unset any API key
# that would shadow the OAuth token and force per-token billing.
# Placed BEFORE inner-loop tests so a missing token fails fast (skips the 60s run).
# NOTE: no `set -x` around this block — the token must never reach a log.
_CLAUDE_AUTH_ENV="${HOS_CLAUDE_AUTH_ENV:-${HOME}/.config/hos/claude-auth.env}"
if [[ ! -r "$_CLAUDE_AUTH_ENV" ]]; then
  echo "$LOG_PREFIX FATAL: missing $_CLAUDE_AUTH_ENV (run 'claude setup-token', store CLAUDE_CODE_OAUTH_TOKEN)"
  _audit cycle-preflight-fail reason=claude_auth_env_missing
  exit 78  # EX_CONFIG
fi
set -a
# shellcheck source=/dev/null
. "$_CLAUDE_AUTH_ENV"
set +a
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
if [[ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
  echo "$LOG_PREFIX FATAL: CLAUDE_CODE_OAUTH_TOKEN not set after sourcing $_CLAUDE_AUTH_ENV"
  _audit cycle-preflight-fail reason=claude_oauth_token_unset
  exit 78
fi

# Optional model-spawning auth probe (opt-in via HOS_CRON_AUTH_PROBE=1). Default
# OFF: a probe spends a model turn on every active fire against the weekly subscription
# limit, and the main invocation surfaces auth failures anyway. Turn on only to
# fail fast on an expired/revoked token before the inner-loop test run.
if [[ "${HOS_CRON_AUTH_PROBE:-0}" == "1" ]]; then
  if ! printf 'ping' | "$CLAUDE_BIN" --print --max-turns 1 >/dev/null 2>&1; then
    echo "$LOG_PREFIX FATAL: Claude auth probe failed (token expired/revoked or API key shadowing)"
    _audit cycle-preflight-fail reason=claude_auth_probe_failed
    exit 75  # EX_TEMPFAIL
  fi
fi

# ── Halt check (#793) — skip cycle if a hos-halt issue is open ───────────────
# #912: FAIL CLOSED. The hos-halt issue is a human emergency stop, so the cycle
# may proceed ONLY when we positively confirm zero open hos-halt issues. An empty
# repo slug, a gh API error, or a non-numeric/empty count means halt-state is
# UNKNOWN — skip the cycle (reason=halt_check_unavailable) rather than risk
# running past an active halt. Previously an empty slug skipped the whole block
# and a gh error defaulted the count to "0", both bypassing the stop control.
if [[ -z "$_REPO_SLUG" ]]; then
  echo "$LOG_PREFIX HALT CHECK UNAVAILABLE: empty repo slug — skipping cycle (fail-closed)"
  _audit cycle-skip reason=halt_check_unavailable
  exit 0
fi
if _HALT_COUNT=$(gh api "repos/${_REPO_SLUG}/issues?state=open&labels=hos-halt&per_page=1" \
    --jq 'length' 2>/dev/null); then
  _HALT_RC=0
else
  _HALT_RC=$?
fi
if [[ "$_HALT_RC" -ne 0 || ! "$_HALT_COUNT" =~ ^[0-9]+$ ]]; then
  echo "$LOG_PREFIX HALT CHECK UNAVAILABLE: gh query failed (rc=$_HALT_RC, count='${_HALT_COUNT}') — skipping cycle (fail-closed)"
  _audit cycle-skip reason=halt_check_unavailable
  exit 0
fi
if [[ "$_HALT_COUNT" -gt 0 ]]; then
  echo "$LOG_PREFIX HALT: open hos-halt issue detected — skipping cycle"
  _audit cycle-skip reason=hos-halt
  exit 0
fi

# ── Agent availability check (#794) — fail-closed on missing agent files ──────
_AGENTS_LIST="$REPO_ROOT/scripts/framework/consumer_agents.txt"
if [[ -f "$_AGENTS_LIST" ]]; then
  _missing_agents=()
  while IFS= read -r _agent_slug; do
    [[ -z "$_agent_slug" || "$_agent_slug" == \#* ]] && continue
    [[ -f "$REPO_ROOT/.claude/agents/${_agent_slug}.md" ]] \
      || _missing_agents+=("$_agent_slug")
  done < "$_AGENTS_LIST"
  if [[ ${#_missing_agents[@]} -gt 0 ]]; then
    echo "$LOG_PREFIX AGENT AVAILABILITY FAIL: missing ${_missing_agents[*]}"
    _audit cycle-preflight-fail reason=agent_availability
    if [[ -n "$_REPO_SLUG" ]]; then
      # #849 (no-idempotency class): fail-CLOSED dedup. A dedup-query *error*
      # must never default the count to 0 — that fails open and files a fresh
      # [BLOCKED] issue every cycle, flooding the queue. Only file when the
      # query SUCCEEDS and confirms zero existing issues; on query failure,
      # skip filing (a duplicate is worse than a deferred file — the missing
      # agent persists, so the next cycle whose query succeeds files once).
      if _aa_existing=$(gh api "repos/${_REPO_SLUG}/issues?state=open&labels=needs-human&per_page=20" \
          --jq '[.[] | select(.title | startswith("[BLOCKED] agent unavailable"))] | length' \
          2>/dev/null); then
        _aa_existing="${_aa_existing:-0}"
        if [[ "$_aa_existing" == "0" ]]; then
          gh issue create \
            --repo "$_REPO_SLUG" \
            --title "[BLOCKED] agent unavailable — ${ROLE} halted (missing: ${_missing_agents[*]})" \
            --label "needs-human,needs-ai" \
            --body "Required agent files missing from \`$REPO_ROOT/.claude/agents/\`: \`${_missing_agents[*]}\`. ${ROLE} cannot launch. Re-run \`hos_install.sh\` or restore the missing files." \
            2>/dev/null || true
        fi
      else
        echo "$LOG_PREFIX WARN: agent-availability dedup query failed — skipping [BLOCKED] issue creation (fail-closed) to avoid duplicate filings"
      fi
    fi
    exit 1
  fi
fi

# ── Target milestone resolution (#780) ────────────────────────────────────────
# Resolve the active release and milestone number so cron prompts never embed a
# literal milestone=<N>. Source of truth: projects.conf target_release key (or
# HOS_TARGET_RELEASE env override). Milestone number derived via REST API so
# rolling to the next release is a single config change, no prompt edit.
HOS_TARGET_RELEASE="${HOS_TARGET_RELEASE:-$(_conf_val target_release)}"
if [[ -n "$HOS_TARGET_RELEASE" ]]; then
  if [[ -z "${HOS_TARGET_MILESTONE_NUMBER:-}" ]]; then
    if [[ -z "$_REPO_SLUG" ]]; then
      echo "$LOG_PREFIX FATAL: cannot derive GitHub repo from git remote (needed for milestone resolution)"
      _audit cycle-preflight-fail reason=milestone_repo_unresolvable
      exit 78
    fi
    HOS_TARGET_MILESTONE_NUMBER=$(gh api "repos/${_REPO_SLUG}/milestones?state=all&per_page=100" \
      --jq ".[] | select(.title == \"${HOS_TARGET_RELEASE}\" or (.title | startswith(\"${HOS_TARGET_RELEASE} \"))) | .number" \
      2>/dev/null | head -1)
    if [[ -z "$HOS_TARGET_MILESTONE_NUMBER" ]]; then
      echo "$LOG_PREFIX FATAL: milestone '${HOS_TARGET_RELEASE}' not found in ${_REPO_SLUG} — set ${PROJECT}_target_release in $PROJECTS_CONF"
      _audit cycle-preflight-fail reason=milestone_not_found
      exit 78
    fi
  fi
  export HOS_TARGET_RELEASE HOS_TARGET_MILESTONE_NUMBER
  echo "$LOG_PREFIX target: ${HOS_TARGET_RELEASE} → milestone #${HOS_TARGET_MILESTONE_NUMBER}"
else
  [[ "$ROLE" == "worker" ]] \
    && echo "$LOG_PREFIX WARN: ${PROJECT}_target_release not set in $PROJECTS_CONF — prompt will not have milestone substituted"
fi

# ── Actionable-work gate (#1395) ──────────────────────────────────────────────
# Everything below is a `gh api` call against GitHub, not local git state, so it
# can run BEFORE git sync and (worker) the baseline test run — the two expensive,
# memory-heavy steps this gate exists to skip on a cycle with nothing to do. This
# machine runs multiple projects' worker/overseer cron cycles concurrently, and
# paying for a full sync + baseline run on a cycle that turns out to be idle
# anyway wastes memory shared with co-located cycles.
#
# A query failure is "unknown", never "empty" — it must never cause a skip on
# its own (mirrors #915: a PR-fetch failure must not be misread as "no open
# PRs"). Skipping on unknown state risks silently dropping real work; the
# self-correction cost of NOT skipping on a transient blip is just this one
# cycle's sync+baseline cost, which is exactly the cost this gate is allowed to
# spend when it can't prove the cycle is idle.
if [[ "$ROLE" == "worker" && -n "$_REPO_SLUG" ]]; then
  # Milestone-less issues (Step 0 triage) — ANY open issue with no milestone,
  # unfiltered by label (Step 0 triages everything regardless of label; that's
  # the point of Step 0). Uses GitHub's `milestone=none` server-side filter,
  # same as `bootstrap/query_issues.sh --list --milestone-less`.
  if _GATE_MILESTONELESS=$(gh api "repos/${_REPO_SLUG}/issues?milestone=none&state=open&per_page=100" \
      --jq '.[] | select(.pull_request == null) | .number' 2>/dev/null); then
    _gate_milestoneless_ok=1
  else
    _gate_milestoneless_ok=0
    _GATE_MILESTONELESS=""
  fi

  # Open release-request issues (#1347 NG3b — standing gate). Same query/jq as
  # the "Open release requests (NG3b)" section of _build_context below; cached
  # here so that section reuses this result instead of querying twice.
  if _GATE_RELEASE_REQUESTS=$(gh api "repos/${_REPO_SLUG}/issues?state=open&labels=release-request&per_page=100" \
      --jq ".[] | select(.pull_request == null) | \"#\(.number) \(.title | .[0:70]) [\(.labels | map(.name) | join(\",\"))] assignees=\(.assignees | length)\"" \
      2>/dev/null); then
    _gate_release_requests_ok=1
  else
    _gate_release_requests_ok=0
    _GATE_RELEASE_REQUESTS=""
  fi

  # Open bot PRs + routing (#791, #1198 Stage 0) — this is the EXACT block that
  # used to live under "Worker: PR-routing decision authority", moved here
  # verbatim (same variables `_PR_ROUTING` / `_OPEN_PR_NUMS`, same stdout
  # messages, same overseer-wakeup side effect, same _audit calls) with only
  # the PR-fetch's success/failure now explicitly distinguished (mirrors #915)
  # so a fetch failure can't be misread as "no open PRs" by this new gate.
  _PR_ROUTING=""
  if _OPEN_PR_NUMS=$(gh api "repos/${_REPO_SLUG}/pulls?state=open&per_page=20" \
      --jq ".[] | select(.user.login == \"${HOS_BOT_LOGIN}\") | .number" 2>/dev/null); then
    _gate_pr_fetch_ok=1
  else
    _gate_pr_fetch_ok=0
    _OPEN_PR_NUMS=""
  fi
  if [[ -n "$_OPEN_PR_NUMS" ]]; then
    _PR_ROUTING="awaiting-merge"
    while IFS= read -r _pr_num; do
      [[ -z "$_pr_num" ]] && continue
      # Check mergeable_state first via detail endpoint — a conflicting PR must
      # be fixed before anything else, even if it has prior APPROVED reviews
      # (#867). REST API uses mergeable_state="dirty" not "CONFLICTING" (GraphQL).
      # Same call also pulls draft + label names (#1350) to detect an overseer
      # bounce (record_pr_bounce() converts the PR to draft + applies
      # `needs-ai`, but never posts a CHANGES_REQUESTED review — see
      # bootstrap/post_review_thread.sh, which always submits COMMENT — so
      # without this the bounce is invisible to the checks below and falls
      # through to needs-attention, whose directive text is the opposite of
      # what's true).
      _pr_detail=$(gh api "repos/${_REPO_SLUG}/pulls/${_pr_num}" \
        --jq '{ms: .mergeable_state, d: .draft, labels: [.labels[].name]}' 2>/dev/null \
        || echo '{"ms":"unknown","d":false,"labels":[]}')
      _pr_ms=$(printf '%s' "$_pr_detail" | python3 -c \
        "import json,sys; print(json.load(sys.stdin).get('ms','unknown'))" 2>/dev/null || echo "unknown")
      _pr_draft=$(printf '%s' "$_pr_detail" | python3 -c \
        "import json,sys; print(json.load(sys.stdin).get('d', False))" 2>/dev/null || echo "False")
      _pr_labels=$(printf '%s' "$_pr_detail" | python3 -c \
        "import json,sys; print(' '.join(json.load(sys.stdin).get('labels', [])))" 2>/dev/null || echo "")
      if [[ "$_pr_ms" == "dirty" ]]; then _PR_ROUTING="needs-fix"; break; fi
      # Bounce check: draft PR carrying `needs-ai` is the overseer's bounce
      # signal (record_pr_bounce()). Checked after `dirty` (a conflicting PR
      # takes priority even if also bounced) and before CHANGES_REQUESTED (the
      # overseer never posts one on a bounce, so that check alone would never
      # catch this case anyway).
      if [[ "$_pr_draft" == "True" && " $_pr_labels " == *" needs-ai "* ]]; then
        _PR_ROUTING="needs-fix-bounce"; break
      fi
      _pr_cr=$(gh api "repos/${_REPO_SLUG}/pulls/${_pr_num}/reviews" \
        --jq '[.[] | select(.state == "CHANGES_REQUESTED")] | length' 2>/dev/null || echo "0")
      _pr_cr="${_pr_cr:-0}"
      if [[ "$_pr_cr" -gt 0 ]]; then _PR_ROUTING="needs-fix"; break; fi
      _pr_ap=$(gh api "repos/${_REPO_SLUG}/pulls/${_pr_num}/reviews" \
        --jq '[.[] | select(.state == "APPROVED")] | length' 2>/dev/null || echo "0")
      _pr_ap="${_pr_ap:-0}"
      if [[ "$_pr_ap" -eq 0 ]]; then _PR_ROUTING="needs-attention"; fi
    done <<< "$_OPEN_PR_NUMS"

    _pr_count=$(echo "$_OPEN_PR_NUMS" | grep -c '[0-9]' 2>/dev/null || echo "?")
    if [[ "$_PR_ROUTING" == "awaiting-merge" ]]; then
      echo "$LOG_PREFIX all ${_pr_count} open PR(s) awaiting human merge — new work blocked, Step 0 triage still runs (#1198)"
      _audit cycle-skip reason=awaiting-merge
      # This wakeup normally gets overwritten by the unconditional
      # "worker-cycle-complete" signal at the end of a successful run (Claude
      # now always launches when there IS actionable work, #1198 item 3) — it's
      # the signal of record only for the rarer case where the script exits
      # before reaching that point (e.g. the #989 missing-prompt-file fatal exit).
      printf '{"reason":"worker-cycle-skip","project":"%s","timestamp":"%s"}\n' \
        "$PROJECT" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        > "$_HOS_DIR/wakeup/overseer-${PROJECT}"
    elif [[ "$_PR_ROUTING" == "needs-attention" ]]; then
      echo "$LOG_PREFIX ${_pr_count} open PR(s) unreviewed — new work blocked, Step 0 triage still runs (#1198)"
      _audit cycle-needs-attention "pr_nums=${_OPEN_PR_NUMS//$'\n'/,}"
    fi
  fi

  # Next-candidate issues in the target milestone — cached for reuse by the
  # "Next work candidates" section of _build_context below (same query, same
  # jq filter — next_candidates.jq is the single source of truth, per its own
  # header comment; querying it twice here would violate that).
  _GATE_CANDIDATES=""
  _gate_candidates_ok=1
  if [[ -n "${HOS_TARGET_MILESTONE_NUMBER:-}" ]]; then
    if _GATE_CANDIDATES=$(gh api "repos/${_REPO_SLUG}/issues?state=open&milestone=${HOS_TARGET_MILESTONE_NUMBER}&labels=needs-ai&per_page=100" \
        --jq "$(cat "$REPO_ROOT/scripts/automation/lib/next_candidates.jq")" \
        2>/dev/null); then
      _gate_candidates_ok=1
    else
      _gate_candidates_ok=0
      _GATE_CANDIDATES=""
    fi
  fi

  # Skip only when every query that COULD reveal work actually succeeded AND
  # came back empty. A single query failure means "unknown" — proceed rather
  # than risk silently skipping real work over a transient API blip (last-run
  # is stamped either way, so this isn't a busy-retry loop; the next fire just
  # resolves the ambiguity fresh).
  _gate_all_ok=1
  [[ "$_gate_milestoneless_ok" -eq 1 ]] || _gate_all_ok=0
  [[ "$_gate_release_requests_ok" -eq 1 ]] || _gate_all_ok=0
  [[ "$_gate_pr_fetch_ok" -eq 1 ]] || _gate_all_ok=0
  [[ "$_gate_candidates_ok" -eq 1 ]] || _gate_all_ok=0

  if [[ "$_gate_all_ok" -eq 1 && -z "$_GATE_MILESTONELESS" && -z "$_GATE_RELEASE_REQUESTS" \
        && -z "$_OPEN_PR_NUMS" && -z "$_GATE_CANDIDATES" ]]; then
    echo "$LOG_PREFIX no actionable work (no milestone-less issues, no release requests, no open PRs, no next-work candidates) — skipping before git sync (#1395)"
    _audit cycle-skip reason=no_actionable_work
    date +%s > "$_LAST_RUN_FILE"
    exit 0
  fi
fi

# ── Overseer: pre-filter actionable PRs before invoking Claude ───────────────
# Deterministically check each open PR's merge status via the detail endpoint
# (the list endpoint returns mergeable=null until GitHub computes it lazily).
# Only non-conflicting, non-draft PRs are passed to the overseer. If none exist,
# skip the Claude invocation entirely — no AI turn wasted on an unmergeable queue.
_HOS_ACTIONABLE_PRS=""   # space-separated "#N" list injected into overseer prompt
_HOS_SKIPPED_PRS=""      # for logging only
if [[ "$ROLE" == "overseer" ]]; then
  # Capture gh's exit status separately from its output (#915). A bare
  # `$(... || true)` swallows a transient API failure into an empty result,
  # which the empty-check below would misread as "no open PRs" — masking the
  # cause (logged as reason=no_open_prs). Treat empty as "no PRs" ONLY when the
  # fetch succeeded; on failure do NOT stamp last-run (so the next cycle
  # retries immediately) and exit with a distinct reason. (#711, #1196.)
  if _open_pr_nums=$(gh api "repos/${_REPO_SLUG}/pulls?state=open&per_page=20" \
      --jq '.[].number' 2>/dev/null); then
    _pr_fetch_ok=1
  else
    _pr_fetch_ok=0
  fi
  if [[ "$_pr_fetch_ok" -eq 0 ]]; then
    echo "$LOG_PREFIX open-PR fetch failed — skipping cycle without stamping last-run"
    _audit cycle-skip reason=pr_fetch_unavailable
    exit 0
  fi
  if [[ -z "$_open_pr_nums" ]]; then
    echo "$LOG_PREFIX no open PRs — skipping cycle"
    _audit cycle-skip reason=no_open_prs
    date +%s > "$_LAST_RUN_FILE"
    exit 0
  fi
  for _pr_num in $_open_pr_nums; do
    _detail=$(gh api "repos/${_REPO_SLUG}/pulls/${_pr_num}" \
      --jq '{ms: .mergeable_state, d: .draft}' 2>/dev/null || echo '{"ms":"unknown","d":false}')
    _ms=$(printf '%s' "$_detail" | python3 -c \
      "import json,sys; print(json.load(sys.stdin).get('ms','unknown'))" 2>/dev/null || echo "unknown")
    _d=$(printf '%s' "$_detail" | python3 -c \
      "import json,sys; print(json.load(sys.stdin).get('d', False))" 2>/dev/null || echo "False")
    if [[ "$_ms" == "dirty" || "$_d" == "True" ]]; then
      _HOS_SKIPPED_PRS="${_HOS_SKIPPED_PRS} #${_pr_num}(${_ms})"
    else
      _HOS_ACTIONABLE_PRS="${_HOS_ACTIONABLE_PRS} #${_pr_num}"
    fi
  done
  _HOS_ACTIONABLE_PRS="${_HOS_ACTIONABLE_PRS# }"
  _HOS_SKIPPED_PRS="${_HOS_SKIPPED_PRS# }"
  if [[ -z "$_HOS_ACTIONABLE_PRS" ]]; then
    echo "$LOG_PREFIX all open PRs are conflicting/draft (${_HOS_SKIPPED_PRS}) — skipping cycle"
    _audit cycle-skip reason=no_actionable_prs "skipped=${_HOS_SKIPPED_PRS}"
    date +%s > "$_LAST_RUN_FILE"
    exit 0
  fi
  echo "$LOG_PREFIX actionable: ${_HOS_ACTIONABLE_PRS} | skipped: ${_HOS_SKIPPED_PRS:-none}"
fi

# ── Git sync ──────────────────────────────────────────────────────────────────
# Fetch the default refspec (not just `main`) — a single-ref `fetch origin main`
# only prunes refs within that same explicit refspec, so a feature branch's
# remote-tracking ref would never be pruned and #1044's "upstream gone" check
# below would never fire.
git -C "$REPO_ROOT" fetch origin --prune --quiet 2>/dev/null || true

# #1415: sweep leftover debris from a dead cycle BEFORE the #1044 return-to-main
# check and the #1393 ff-only guard — both of which a dirty tree defeats. Opt-in
# (<project>_worktree_hygiene=preserve); a no-op otherwise. Never exits.
_worktree_hygiene

# #1044: return to main once a feature branch's PR has merged (its remote branch
# is now gone). Without this the checkout never leaves the branch it just built
# work on, and the #996 guard below — which must test `main` itself, not
# whatever HEAD happens to be parked on — would have nothing meaningful to
# reconcile. A branch whose PR is still open keeps its upstream and is left
# alone; a dirty/conflicting working tree leaves HEAD as-is (nothing is
# force-discarded). Local branch cleanup is a separate concern (#1044 scope note).
_cur_branch=$(git -C "$REPO_ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
if [[ -n "$_cur_branch" && "$_cur_branch" != "main" ]] \
   && git -C "$REPO_ROOT" show-ref --verify --quiet refs/heads/main \
   && ! git -C "$REPO_ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  if git -C "$REPO_ROOT" checkout --quiet main 2>/dev/null; then
    echo "$LOG_PREFIX returned to main from '$_cur_branch' (upstream gone — merged & pruned) (#1044)"
  else
    echo "$LOG_PREFIX could not return to main from '$_cur_branch' (dirty tree?) — leaving HEAD as-is"
  fi
fi

# #1498: reap stranded zero-commit local branches (worker only, always on, no
# config). A cycle that dies before its first commit (crash, kill, OOM) leaves
# a branch that the #1044 block above never touches — local branch cleanup was
# explicitly out of #1044's scope. Runs every worker cycle (periodic sweep,
# not tied to any one issue number — simpler and more robust than trying to
# catch the next cycle that happens to touch the same issue) and reads the
# branch-ownership store (bootstrap/lib/branch_ownership.sh, #967 ADR-037) —
# the ONLY place a branch this worker created is durably recorded. Guarded for
# the library's existence: an older/foreign target project without it just
# skips the sweep, no error. A record is read (grep for its `branch=` line),
# never eval'd/sourced. Only ever deletes a LOCAL branch that is EXACTLY zero
# commits ahead of main — anything with commits is left alone (could be
# legitimate in-progress or awaiting-review work, out of #1498's scope) — and
# never the branch currently checked out. Best-effort throughout: this is
# hygiene, not correctness-critical, and a find/git/rm failure must never
# abort the cycle.
#
# A missing-branch record is NOT unconditionally stale: bootstrap/create_branch.sh
# writes the ownership record BEFORE creating the branch (Step 4, then Step 5)
# by design, so a mid-write crash orphans a record, not a branch. Under #1265
# (two same-role cron processes can overlap on the same REPO_ROOT), a reap
# sweep landing in that exact narrow window could otherwise delete another
# concurrently-running cycle's about-to-be-real record. Only reap a
# missing-branch record once it is older than a grace window (mtime, not a
# parsed created_at= — simpler, avoids ISO8601 parsing) — a record younger
# than that is left alone this cycle; a later cycle catches it once genuinely
# stale.
#
# The same grace window guards the zero-commit *branch*-deletion path, not
# just the missing-record pruning path above: a branch that exists locally,
# reads zero-commits-ahead, and isn't the currently-checked-out branch is
# exactly the state of another concurrently-running cycle's brand-new branch
# in the window between create_branch.sh's checkout and its first commit —
# the #1044 return-to-main check above already parks HEAD back on main for
# any branch lacking an upstream, which every such branch does, so it will
# not be this cycle's own HEAD either. A zero-commit branch is therefore only
# ever deleted once its ownership record is at least as old as
# $_BO_REAP_GRACE_SECS; a younger record leaves both the branch and the
# record untouched for a later cycle to re-check.
_BO_REAP_GRACE_SECS=300
if [[ "$ROLE" == "worker" ]]; then
  _BO_LIB="$REPO_ROOT/bootstrap/lib/branch_ownership.sh"
  if [[ -f "$_BO_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$_BO_LIB" 2>/dev/null || true
    if command -v hos_bo_store_dir >/dev/null 2>&1; then
      _bo_store="$(hos_bo_store_dir "$REPO_ROOT" 2>/dev/null || true)"
      if [[ -n "$_bo_store" && -d "$_bo_store" ]]; then
        _bo_cur_branch=$(git -C "$REPO_ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
        while IFS= read -r -d '' _bo_rec; do
          _bo_branch="$(grep -m1 '^branch=' "$_bo_rec" 2>/dev/null | cut -d= -f2-)"
          [[ -z "$_bo_branch" ]] && continue
          [[ "$_bo_branch" == "$_bo_cur_branch" ]] && continue
          # Ownership-record age, used as the grace-window signal on BOTH
          # deletion paths below (missing-branch record pruning, and
          # zero-commit local-branch deletion) — a freshly-created,
          # not-yet-committed branch from a concurrently-running cycle (#1265)
          # is routinely not this reaper's own checked-out HEAD, since the
          # #1044 return-to-main check above already parked HEAD back on main
          # for any local branch lacking an upstream, which is true of every
          # brand-new, unpushed branch. Without this check, a zero-commit
          # branch could be force-deleted before its owning cycle gets a
          # chance to commit anything to it.
          _bo_rec_mtime=""
          if ! _bo_rec_mtime=$(stat -c %Y "$_bo_rec" 2>/dev/null); then
            _bo_rec_mtime=$(stat -f %m "$_bo_rec" 2>/dev/null || echo "")
          fi
          _bo_now=$(date +%s)
          _bo_rec_within_grace=0
          if [[ -z "$_bo_rec_mtime" || $(( _bo_now - _bo_rec_mtime )) -lt $_BO_REAP_GRACE_SECS ]]; then
            _bo_rec_within_grace=1
          fi
          if ! git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$_bo_branch"; then
            # Branch doesn't exist locally — either already gone (safe to drop
            # the stale record) or create_branch.sh hasn't reached its
            # checkout step yet (NOT safe — see grace-window note above).
            if [[ "$_bo_rec_within_grace" -eq 0 ]]; then
              rm -f "$_bo_rec" 2>/dev/null || true
            fi
            continue
          fi
          if [[ "$_bo_rec_within_grace" -eq 1 ]]; then
            # Record too young to trust a zero-commit reading — a
            # concurrently-running cycle may not have committed yet. Leave the
            # branch and its record alone; a later cycle re-checks once stale.
            continue
          fi
          _bo_ahead="$(git -C "$REPO_ROOT" rev-list --count "main..$_bo_branch" 2>/dev/null || echo "")"
          if [[ "$_bo_ahead" == "0" ]]; then
            if git -C "$REPO_ROOT" branch -D "$_bo_branch" 2>/dev/null; then
              rm -f "$_bo_rec" 2>/dev/null || true
              echo "$LOG_PREFIX reaped stranded zero-commit branch '$_bo_branch' (#1498)"
              _audit cycle-branch-reap "branch=${_bo_branch}"
            else
              # Deletion failed (e.g. ref-lock contention under #1265) — leave
              # the record in place so a later cycle can retry; never claim a
              # reap that didn't happen.
              echo "$LOG_PREFIX WARN: could not delete stranded zero-commit branch '$_bo_branch' — leaving its ownership record in place (#1498)"
              _audit cycle-branch-reap-failed "branch=${_bo_branch}"
            fi
          fi
        done < <(find "$_bo_store" -maxdepth 1 -name '*.rec' -print0 2>/dev/null)
      fi
    fi
  fi
fi

# #996/#1044: never let a diverged local main be masked by `|| true`. A SIGTERM
# between a session's commit and push can strand a stray commit on main; from
# then on every fast-forward fails and silently discarding it would let the
# worker keep cutting branches from a drifting base with no signal at all.
# Tested against the local `main` branch itself — not HEAD, which may be parked
# on an unrelated feature branch (#1044) — using patch-id equivalence
# (`git cherry`) so a squash-merged commit (same content, new SHA on
# origin/main) is never misread as a stray local commit.
# `grep -c` already prints "0" on no-match but exits 1 — guard with `|| true`,
# not `|| echo 0`, or the fallback appends a second "0" line and breaks the
# numeric comparison below.
_stray=$(git -C "$REPO_ROOT" cherry origin/main main 2>/dev/null | grep -c '^+' || true)
if [[ "${_stray:-0}" -gt 0 ]]; then
  echo "$LOG_PREFIX ⚠ local main has DIVERGED from origin/main — ${_stray} local commit(s) on main with no upstream-equivalent (a stray commit from a killed session?). Skipping cycle fail-closed (#996); inspect: git -C \"$REPO_ROOT\" cherry -v origin/main main"
  _audit cycle-preflight-fail reason=local_main_diverged stray="${_stray}"
  exit 0
fi
# main carries nothing origin/main doesn't already have (by content) — safe to
# bring it to origin/main's tip, whether or not HEAD is currently on main.
if [[ "$(git -C "$REPO_ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")" == "main" ]]; then
  # #1393: only treat a failed fast-forward as meaningful when origin/main
  # actually exists — an unconfigured/test-fixture repo with no remote fails
  # this merge trivially and must not be mistaken for a real sync problem.
  # When origin/main does exist, a failure here means the working tree is
  # genuinely dirty or diverged in a way the #996 stray-commit check above
  # didn't catch (that check only looks at committed history, not uncommitted
  # tracked-file changes) — masking it with `|| true` would let the cycle
  # proceed and build against a stale main with no signal anywhere.
  if git -C "$REPO_ROOT" rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
    if ! git -C "$REPO_ROOT" merge --ff-only --quiet origin/main 2>/dev/null; then
      echo "$LOG_PREFIX ⚠ local main could not fast-forward to origin/main (dirty tree or unresolved divergence) — skipping cycle fail-closed (#1393); inspect: git -C \"$REPO_ROOT\" status"
      _audit cycle-preflight-fail reason=local_main_ff_only_failed
      exit 0
    fi
  fi
else
  git -C "$REPO_ROOT" update-ref refs/heads/main refs/remotes/origin/main 2>/dev/null || true
fi

# ── Inner-loop baseline (worker only) — skip when repo is known-clean (#789) ──
# Cycle-start tests exist to establish a known-good baseline before Claude touches
# the repo, catching a broken tree left by a previously-crashed cycle. That only
# has value when state is UNKNOWN. When HEAD matches the last SHA at which the
# baseline passed (the "cowpat") and the worktree is clean, nothing has changed
# since the last green run — skip the redundant ~2–3 min suite. The pre-PR §8.7
# gate (Claude runs tests against its own changes before any PR) is unchanged and
# is the real safety net; this only trims the redundant cycle-start run.
if [[ "$ROLE" == "worker" ]]; then
  _COWPAT_FILE="$_HOS_DIR/test-clean/${ROLE}-${PROJECT}"
  _CURRENT_HEAD=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo "")

  # #1415: a note appended to the broken-state escalation body below, telling a
  # human whether the worktree was verified clean (this is genuine breakage) or
  # hygiene itself failed (the red baseline may be leftover debris, not a real
  # regression). Empty when hygiene is off/disabled — must stay byte-identical
  # to the pre-#1415 escalation body in that case.
  _HYGIENE_NOTE=""
  case "$_HYGIENE_RESULT" in
    disabled) ;;
    nothing_to_sweep|swept)
      if [[ "$_HYGIENE_RESULT" == "swept" ]]; then
        _hy_preserved="${_HYGIENE_COUNT} path(s) swept to \`$_HYGIENE_QUARANTINE\`"
      else
        _hy_preserved="nothing to sweep"
      fi
      _HYGIENE_NOTE="$(printf '**Worktree hygiene (#1415):** the worktree was verified clean (%s) at pre-merge `%s` / post-merge `%s` and the suite still failed — this is genuine breakage, not debris.' \
        "$_hy_preserved" "${_HYGIENE_BASE_SHA:-unknown}" "${_CURRENT_HEAD:-unknown}")" ;;
    failed)
      _HYGIENE_NOTE="$(printf '**Worktree hygiene (#1415): FAILED — %s.** Residual dirty path(s): `%s`. The red baseline may be a consequence of this leftover debris rather than genuine breakage — inspect the worktree (`git -C %s status`) before assuming the code itself is broken.' \
        "$_HYGIENE_REASON" "${_HYGIENE_RESIDUAL:-unknown}" "$REPO_ROOT")" ;;
  esac

  _CLEAN_SHA=$(cat "$_COWPAT_FILE" 2>/dev/null || echo "")
  _WORKTREE_DIRTY=$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null || echo "")

  if [[ -n "$_CURRENT_HEAD" && "$_CURRENT_HEAD" == "$_CLEAN_SHA" && -z "$_WORKTREE_DIRTY" ]]; then
    # Known clean: HEAD unchanged since the last green baseline and no uncommitted
    # files. Skip — Claude still runs tests before any PR (§8.7). No audit event:
    # the steady-state skip fires every cycle and would flood the audit log.
    echo "$LOG_PREFIX environment clean (HEAD ${_CURRENT_HEAD:0:12} matches cowpat) — skipping cycle-start baseline test run"
  else
    # Unknown or dirty state — no cowpat (first run), HEAD moved since the last
    # green run, a dirty tree from a crashed cycle, or HEAD unresolvable. Run the
    # baseline before Claude starts so it never builds on a broken tree.
    #
    # #1498: before paying for the ~2-3 min suite, check whether this is an
    # EXACT repeat of the last recorded failure — same HEAD, same worktree
    # fingerprint, so a dirty tree that changes between cycles still counts as
    # new state. The fingerprint must be byte-content-aware, not just
    # path+status-letter (`git status --porcelain` alone): two different
    # crashed cycles that each leave dirty state on the same filename(s) with
    # the same status letters but different actual content would otherwise
    # hash identically and produce a false cache hit. A dead cycle's debris
    # fails the baseline identically on every subsequent cycle with zero new
    # information per re-run (#1413) — skip the redundant invocation and reuse
    # the recorded exit code, which then flows through the unchanged
    # halt/repair-mode classification and dedup'd issue filing below exactly
    # as if the suite had just been re-run and failed the same way.
    _bs_fp_stream() {
      # Tracked changes' byte content, plus every untracked file's path AND
      # raw content (null-delimited paths so embedded spaces survive). Every
      # git call is `|| true`-guarded and the function always returns 0 — a
      # failure here must degrade to "treat as changed" (re-run the suite),
      # never abort the cycle.
      git -C "$REPO_ROOT" diff HEAD -- . 2>/dev/null || true
      git -C "$REPO_ROOT" ls-files --others --exclude-standard -z 2>/dev/null | while IFS= read -r -d '' _bs_u; do
        printf '%s\0' "$_bs_u"
        cat -- "$REPO_ROOT/$_bs_u" 2>/dev/null
      done || true
      return 0
    }
    _BR_STATE="$_HOS_DIR/baseline-red/${ROLE}-${PROJECT}"
    if command -v md5sum &>/dev/null; then
      _bs_fp=$(_bs_fp_stream | md5sum | cut -d' ' -f1)
    elif command -v md5 &>/dev/null; then
      _bs_fp=$(_bs_fp_stream | md5)
    else
      _bs_fp=$(_bs_fp_stream | cksum | awk '{print $1}')
    fi
    _bs_prev_sha="" _bs_prev_fp="" _bs_prev_exit=""
    if [[ -f "$_BR_STATE" ]]; then
      _bs_prev_sha=$(sed -n 's/^sha=//p' "$_BR_STATE" 2>/dev/null)
      _bs_prev_fp=$(sed -n 's/^fp=//p' "$_BR_STATE" 2>/dev/null)
      _bs_prev_exit=$(sed -n 's/^exit=//p' "$_BR_STATE" 2>/dev/null)
    fi
    if [[ -n "$_CURRENT_HEAD" && "$_CURRENT_HEAD" == "$_bs_prev_sha" \
          && -n "$_bs_fp" && "$_bs_fp" == "$_bs_prev_fp" \
          && "$_bs_prev_exit" =~ ^[0-9]+$ ]]; then
      echo "$LOG_PREFIX INNER-LOOP BASELINE: identical to last recorded failure (HEAD unchanged, worktree unchanged) — skipping redundant re-run (#1498)"
      _audit cycle-baseline-repeat-skip "sha=${_CURRENT_HEAD:0:12}" "exit=${_bs_prev_exit}"
      _bs_exit="$_bs_prev_exit"
    else
      _bs_exit=0
      bash "$REPO_ROOT/scripts/framework/run_tests_inner_loop.sh" -q 2>/dev/null || _bs_exit=$?
    fi
    _bs_title_prefix="[BLOCKED] inner-loop tests failing on ${PROJECT}"
    _bs_repair_state="$_HOS_DIR/baseline-repair/${ROLE}-${PROJECT}"
    if [[ "$_bs_exit" -ne 0 ]]; then
      # #1498: record this failure's fingerprint so an identical next cycle can
      # skip the redundant re-run above. Written whether the suite just ran or
      # the exit code was reused from the cache — idempotent either way.
      mkdir -p "$(dirname "$_BR_STATE")" 2>/dev/null || true
      {
        printf 'sha=%s\n' "${_CURRENT_HEAD}"
        printf 'fp=%s\n' "${_bs_fp}"
        printf 'exit=%s\n' "${_bs_exit}"
      } > "$_BR_STATE" 2>/dev/null || true
      echo "$LOG_PREFIX INNER-LOOP BASELINE TESTS FAILED (exit $_bs_exit)"
      _audit cycle-preflight-fail "reason=inner_loop_tests_failed exit=$_bs_exit"

      # #1496: a red baseline is fixable work, no different from any other
      # backlog bug — the worker diagnoses the root cause (test or code, any
      # surface, no bypass) and fixes it through the completely normal
      # build/PR/review pipeline instead of halting for a human on every red
      # baseline. Classify first: pytest exit 1 means tests were collected
      # and RAN — ordinary, fixable assertion failures. Any other nonzero
      # exit (2=collection/session error, 3=internal error, 4=usage error,
      # 5=no tests collected) means the environment itself is broken; the
      # worker cannot fix infrastructure, so those always halt regardless of
      # mode. Default flipped halt→repair (#1496, was #959 opt-in); explicit
      # <project>_baseline_on_red=halt restores the exact legacy behavior
      # below (needs-human, immediate halt, no attempt tracking) for a
      # project that wants strict human gating on every red baseline.
      _bs_mode="$(_conf_val baseline_on_red)"; _bs_mode="${_bs_mode:-repair}"

      if [[ "$_bs_mode" == "repair" && "$_bs_exit" -eq 1 ]]; then
        # #1496: diagnose-and-fix path. The [BLOCKED] issue is filed/reused as
        # needs-ai,priority:critical — NEVER needs-human on first failure —
        # so it flows through the completely normal Step 2 "next work
        # candidate" selection (priority:critical already sorts it first
        # there, see scripts/automation/lib/next_candidates.jq). Only
        # HOS_BASELINE_REPAIR_MAX_ATTEMPTS consecutive cycles without
        # reaching green escalates to needs-human.
        _bs_max="${HOS_BASELINE_REPAIR_MAX_ATTEMPTS:-3}"
        _bs_attempts=$(( $(cat "$_bs_repair_state" 2>/dev/null || echo 0) + 1 ))
        mkdir -p "$(dirname "$_bs_repair_state")"
        printf '%s\n' "$_bs_attempts" > "$_bs_repair_state"
        _audit cycle-baseline-repair "attempt=${_bs_attempts}/${_bs_max}"

        _bs_issue_num=""
        if [[ -n "$_REPO_SLUG" ]]; then
          # #1496: dedup on title-prefix only, not labels — a standing
          # [BLOCKED] issue may carry needs-ai only (mid-attempt-cycle) or
          # needs-ai,needs-human (already escalated); either way it is the
          # same issue and must not be duplicated. Fail-CLOSED as before: a
          # query error must never default to "no existing issue" and file a
          # duplicate — skip the lookup/filing this cycle instead.
          if _bs_open=$(gh api "repos/${_REPO_SLUG}/issues?state=open&per_page=20" \
              --jq "[.[] | select(.title | startswith(\"${_bs_title_prefix}\"))] | .[].number" \
              2>/dev/null); then
            _bs_issue_num="$(printf '%s\n' "$_bs_open" | head -1)"
          else
            echo "$LOG_PREFIX WARN: broken-state dedup query failed — skipping issue lookup this cycle (fail-closed)"
          fi

          if [[ -z "$_bs_issue_num" ]]; then
            # #1415: same construction as the legacy body below — with
            # hygiene off/disabled, _HYGIENE_NOTE is empty.
            _bs_body="$(printf 'Cycle-start inner-loop baseline tests are failing on \`%s\` at HEAD \`%s\`. Per #1496, the worker will diagnose whether the test or the code is at fault and fix the root cause through the normal build/PR/review pipeline — no special bypass, any surface (including protected ones) is fair game. Escalates to a human only after %s consecutive cycles without reaching green.\n\nReproduce locally:\n\n    bash scripts/framework/run_tests_inner_loop.sh\n' "$PROJECT" "${_CURRENT_HEAD:-unknown}" "$_bs_max")"
            [[ -n "$_HYGIENE_NOTE" ]] && _bs_body="${_bs_body}"$'\n\n'"${_HYGIENE_NOTE}"
            if _bs_created=$(gh issue create \
                --repo "$_REPO_SLUG" \
                --title "${_bs_title_prefix} — diagnose and fix" \
                --label "needs-ai,priority:critical" \
                --body "$_bs_body" \
                2>/dev/null); then
              _bs_issue_num="${_bs_created##*/}"
              echo "$LOG_PREFIX filed baseline diagnose-and-fix issue #${_bs_issue_num}"
              # #1496: only PATCH the milestone on first creation — an
              # already-open issue was PATCHed once already and must not be
              # re-PATCHed every cycle. Best-effort: a milestone-assignment
              # failure must never block the cycle, only the milestone-scoped
              # Step 2 query picking the issue up (it still sorts first once
              # assigned).
              if [[ -n "${HOS_TARGET_MILESTONE_NUMBER:-}" && -n "$_bs_issue_num" ]]; then
                gh api -X PATCH "repos/${_REPO_SLUG}/issues/${_bs_issue_num}" \
                  -f "milestone=${HOS_TARGET_MILESTONE_NUMBER}" \
                  2>/dev/null || true
              fi
            else
              echo "$LOG_PREFIX WARN: baseline diagnose-and-fix issue filing failed"
            fi
          else
            echo "$LOG_PREFIX baseline diagnose-and-fix issue #${_bs_issue_num} already open — not filing a duplicate"
          fi
        fi

        if [[ "$_bs_attempts" -le "$_bs_max" ]]; then
          # #1496: no banner/env-var scoping needed — the needs-ai,
          # priority:critical, milestone-assigned issue sorts first in the
          # normal Step 2 candidate selection on its own.
          echo "$LOG_PREFIX baseline repair mode: attempt ${_bs_attempts}/${_bs_max} — diagnose-and-fix issue is this cycle's top-priority work"
        else
          echo "$LOG_PREFIX baseline repair exhausted after ${_bs_attempts} attempts without a green baseline — escalating to human"
          if [[ -n "$_REPO_SLUG" && -n "$_bs_issue_num" ]]; then
            gh issue edit "$_bs_issue_num" --repo "$_REPO_SLUG" --add-label needs-human 2>/dev/null || true
            gh issue comment "$_bs_issue_num" --repo "$_REPO_SLUG" \
              --body "Attempt cap (${_bs_max}) reached without a green baseline — escalating to human. See the diagnosis comments posted on this issue each cycle for the round-by-round record." \
              2>/dev/null || true
          fi
          exit 1
        fi
        # The diagnose-and-fix issue is filed/reused above — do NOT stamp the
        # cowpat below; the baseline is still red. Fall through so the cycle
        # continues normally (git sync, Claude launch, etc.) instead of
        # halting — the issue itself is this cycle's top-priority work.
      else
        # Legacy halt path (#789, unchanged by #1496): mode=halt (explicit
        # opt-out) with exit=1, or any exit=2-5 (environmental/collection
        # failure — always halts regardless of mode; the worker cannot fix
        # broken infrastructure). Rather than a silent exit, file a
        # needs-human issue so a human can investigate/authorize a fix — the
        # worker is halted until the baseline is green again. Fail-CLOSED
        # dedup mirrors the #849 agent-availability guard: only file when the
        # dedup query SUCCEEDS and confirms zero existing broken-state
        # issues. A query error must never default the count to 0 — that
        # would file a fresh issue every cycle and flood the queue. On query
        # failure, skip filing; the next cycle whose query succeeds files
        # once.
        if [[ -n "$_REPO_SLUG" ]]; then
          if _bs_existing=$(gh api "repos/${_REPO_SLUG}/issues?state=open&labels=needs-human&per_page=20" \
              --jq "[.[] | select(.title | startswith(\"${_bs_title_prefix}\"))] | length" \
              2>/dev/null); then
            _bs_existing="${_bs_existing:-0}"
            if [[ "$_bs_existing" == "0" ]]; then
              # #1415: the format string and args are UNCHANGED from before this
              # feature — with hygiene off/disabled, _HYGIENE_NOTE is empty and
              # _bs_body is byte-identical to the old inline --body value.
              _bs_body="$(printf 'Cycle-start inner-loop baseline tests are failing on \`%s\` at HEAD \`%s\`. The worker is halted — it will not launch Claude or open PRs until the baseline is green.\n\nThis usually means a previous cycle left the repo in a broken state. A human should investigate, fix or revert the breakage, and close this issue (or authorize an AI fix).\n\nReproduce locally:\n\n    bash scripts/framework/run_tests_inner_loop.sh\n' "$PROJECT" "${_CURRENT_HEAD:-unknown}")"
              [[ -n "$_HYGIENE_NOTE" ]] && _bs_body="${_bs_body}"$'\n\n'"${_HYGIENE_NOTE}"
              gh issue create \
                --repo "$_REPO_SLUG" \
                --title "${_bs_title_prefix} — worker halted" \
                --label "needs-human,needs-ai" \
                --body "$_bs_body" \
                2>/dev/null && echo "$LOG_PREFIX filed broken-state needs-human issue" \
                || echo "$LOG_PREFIX WARN: broken-state issue filing failed"
            else
              echo "$LOG_PREFIX broken-state issue already open — not filing a duplicate"
            fi
          else
            echo "$LOG_PREFIX WARN: broken-state dedup query failed — skipping issue creation (fail-closed) to avoid duplicate filings"
          fi
        fi
        exit 1
      fi
    else
      # Baseline green — reset any standing repair-attempt counter and
      # auto-close a standing [BLOCKED] issue (#959): the steady state must not
      # stay "permanently parked + stale human issue" once the tree recovers.
      rm -f "$_bs_repair_state"
      # #1498: also clear any recorded red state — a fresh failure later must
      # not be compared against a stale pre-fix record.
      rm -f "$_BR_STATE"
      if [[ -n "$_REPO_SLUG" ]]; then
        # #1496: match on title-prefix only, not labels — a standing
        # [BLOCKED] issue may now carry needs-ai only (mid-attempt-cycle),
        # needs-ai,needs-human (escalated), or needs-human,needs-ai (legacy
        # halt path); auto-close must catch all of them.
        if _bs_open_nums=$(gh api "repos/${_REPO_SLUG}/issues?state=open&per_page=20" \
            --jq "[.[] | select(.title | startswith(\"${_bs_title_prefix}\"))] | .[].number" \
            2>/dev/null); then
          while IFS= read -r _bs_num; do
            [[ -z "$_bs_num" ]] && continue
            gh issue close "$_bs_num" --repo "$_REPO_SLUG" \
              --comment "Baseline is green again at HEAD \`${_CURRENT_HEAD:-unknown}\` — auto-closing." \
              2>/dev/null && echo "$LOG_PREFIX auto-closed broken-state issue #${_bs_num}" \
              || echo "$LOG_PREFIX WARN: failed to auto-close broken-state issue #${_bs_num}"
          done <<< "$_bs_open_nums"
        fi
      fi
      # Stamp the cowpat with the SHA just verified so the next cycle on an
      # unchanged repo skips the redundant run. Only when HEAD resolved (a
      # non-git or unresolvable REPO_ROOT leaves no marker → always re-runs).
      [[ -n "$_CURRENT_HEAD" ]] && printf '%s\n' "$_CURRENT_HEAD" > "$_COWPAT_FILE"
    fi
  fi
fi


# ── Cycle start ───────────────────────────────────────────────────────────────
_audit cycle-start "bot=$HOS_BOT_LOGIN project=$PROJECT cycle_id=$HOS_CYCLE_ID"
echo "$LOG_PREFIX Authenticated as $HOS_BOT_LOGIN — starting $ROLE cycle"

# ── Per-fire bounds (#728 Task 2) ─────────────────────────────────────────────
# Headless fires draw from the same weekly subscription rate limit as interactive use, and
# a hung/runaway autonomous session could burn it. The always-on bound is a
# WALL-CLOCK timeout — it kills a stuck session without truncating legitimate
# turn-by-turn pipeline work (a low --max-turns would leave a half-done task).
#   HOS_CRON_MAX_SECONDS  wall-clock cap (default 1800 = 30m); 0 disables. Resolved
#                         (flag/env/conf/default, #1434) well above — see there.
#   HOS_CRON_MAX_TURNS    optional --max-turns backstop (default unset = no cap).
# NOTE: --allowedTools is intentionally NOT set. The worker dispatches sub-agents
# (architect/coder/reviewers) and edits files; CLI-level tool restriction is the
# wrong layer and would silently break autonomous work. Tool scope is governed by
# the agent definitions and the LOOP prompt, not the launcher.
# Portable timeout (GNU `timeout` absent on macOS; `gtimeout` via coreutils)
if command -v timeout &>/dev/null; then _TIMEOUT_BIN="timeout"
elif command -v gtimeout &>/dev/null; then _TIMEOUT_BIN="gtimeout"
else _TIMEOUT_BIN=""; fi

# Headless cron sessions have no human to approve tool calls. bypassPermissions
# clears the approval gate so the agent can run gh/git/bash unattended. The safety
# net is the GitHub App's scoped permissions + the overseer's merge guardrails
# (OVERSEER_CEILING, protected surfaces, human-required escalations) — NOT the CLI
# permission gate. Chosen over --dangerously-skip-permissions, which refuses to run
# as root and needs a separate enable flag (friction on unattended Linux servers).
_claude_cmd=("$CLAUDE_BIN" --print --permission-mode bypassPermissions)
[[ -n "${HOS_CRON_MAX_TURNS:-}" ]] && _claude_cmd+=(--max-turns "$HOS_CRON_MAX_TURNS")
# #1446: fixed-path capture of claude's own stdout, rewritten in full on every
# run (`tee` truncates by default — no `-a`) so the usage-limit breaker below
# can grep the current cycle's output only, never a growing log (human ruling
# in the issue: mirror sync_human_clone.sh's write_status() overwrite pattern).
_CLAUDE_OUTPUT_CAPTURE="$_HOS_DIR/last-claude-output/${ROLE}-${PROJECT}"
_run_claude() {  # stdin is inherited → passed through to claude
  # #1126: claude's `.claude/agents/*.md` custom-subagent discovery is
  # cwd-based at process start — NOT derived from the "WORKING DIRECTORY:"
  # text injected into the prompt below. Without this `cd`, the process
  # inherits cron's own launch cwd (unrelated to $REPO_ROOT), so the worker
  # can dispatch none of its 26 shipped agents and silently falls back to
  # built-ins (claude/Explore/general-purpose/Plan/statusline-setup) — the
  # exact specialist-substitution the #608/#609 governance finding forbids.
  # Scoped to a subshell (matches `_audit`'s `(cd "$REPO_ROOT" && ...)`
  # pattern above) so it never perturbs the launcher's own cwd.
  #
  # #1446: `tee` streams the real output through unchanged (nothing is
  # silenced) while also capturing it to $_CLAUDE_OUTPUT_CAPTURE. `tee`'s own
  # exit code is always 0 and would otherwise mask a real claude/timeout
  # failure, so the function's return value is taken explicitly from
  # PIPESTATUS[0] (the left-hand side of the pipe) rather than trusted to
  # `$?` after the pipeline.
  if [[ -n "$_TIMEOUT_BIN" && "$HOS_CRON_MAX_SECONDS" != "0" ]]; then
    (cd "$REPO_ROOT" && "$_TIMEOUT_BIN" "$HOS_CRON_MAX_SECONDS" "${_claude_cmd[@]}") | tee "$_CLAUDE_OUTPUT_CAPTURE"
    return "${PIPESTATUS[0]}"
  else
    [[ -z "$_TIMEOUT_BIN" ]] && echo "$LOG_PREFIX WARN: no timeout/gtimeout — claude runs unbounded"
    (cd "$REPO_ROOT" && "${_claude_cmd[@]}") | tee "$_CLAUDE_OUTPUT_CAPTURE"
    return "${PIPESTATUS[0]}"
  fi
}

# ── Invoke Claude — stdin pipe avoids '---' being parsed as a CLI flag ───────
# Capture the real exit code: under `set -e`, a bare failing command in an if-body
# would abort the script before `$?` is read, so guard with `|| _claude_exit=$?`.
# #805: inject WORKING DIRECTORY from $REPO_ROOT so prompt files never embed a
# machine-specific path. Also applies @@MILESTONE@@ substitution (#780) and
# prepends the overseer pre-filter preamble (#852).
PROMPT_FILE="$REPO_ROOT/bootstrap/${ROLE}-cron-prompt.md"
_run_start_epoch=$(date +%s)
_claude_exit=0
_build_prompt() {
  printf 'WORKING DIRECTORY: %s\n\n' "$REPO_ROOT"
  if [[ -n "${HOS_TARGET_MILESTONE_NUMBER:-}" ]]; then
    sed -e "s/@@TARGET_RELEASE@@/${HOS_TARGET_RELEASE}/g" \
        -e "s/@@MILESTONE_NUMBER@@/${HOS_TARGET_MILESTONE_NUMBER}/g" \
        "$PROMPT_FILE"
  else
    cat "$PROMPT_FILE"
  fi
  _build_context
}

# #792: pre-compute cycle context (open bot PRs + next work candidates) so the
# agent skips the Step 1/2 discovery API calls and proceeds directly to decisions.
# Fail-open: any section that errors is silently omitted; never abort the launch.
_build_context() {
  printf '\n## Pre-computed cycle context — %s\n\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

  printf '### Open bot PRs\n'
  if [[ -n "${_REPO_SLUG:-}" && -n "${HOS_BOT_LOGIN:-}" ]]; then
    _ctx_prs=$(gh api "repos/${_REPO_SLUG}/pulls?state=open&per_page=20" \
      --jq ".[] | select(.user.login == \"${HOS_BOT_LOGIN}\") | \"#\(.number) \(.title | .[0:70]) [\(.labels | map(.name) | join(\",\"))]\"" \
      2>/dev/null || echo "")
    if [[ -n "$_ctx_prs" ]]; then
      printf '%s\n' "$_ctx_prs"
    else
      printf 'None.\n'
    fi
  else
    printf '(repo slug not available)\n'
  fi

  printf '\n'

  # #1347 Amendment 1 (NG3b): a standing gate, not new work — the worker must
  # evaluate open release-request issues every cycle regardless of the "New
  # work directive" below (which only gates *new* backlog work), so this
  # section renders first. Fail-open like the rest of this function: if the
  # fetch fails the section reads "None." and the release simply waits
  # another cycle (a latency cost only) — this context block can never
  # *authorize* a release, since the worker's actual authorization check
  # (NG3b step R5) re-reads issue state/labels/events live from the API and
  # never trusts what is precomputed here.
  if [[ "${ROLE:-}" == "worker" && -n "${_REPO_SLUG:-}" ]]; then
    printf '### Open release requests (NG3b)\n'
    if [[ -n "${_GATE_RELEASE_REQUESTS:-}" ]]; then
      printf '%s\n' "$_GATE_RELEASE_REQUESTS"
    else
      printf 'None.\n'
    fi
    printf '\n'
  fi

  if [[ "${ROLE:-}" == "worker" ]]; then
    printf '### New work directive (#1198) — single decision authority; obey, do not re-derive\n'
    if [[ -n "${_OPEN_PR_NUMS:-}" ]]; then
      _ctx_pr_list="$(printf '%s' "$_OPEN_PR_NUMS" | tr '\n' ',' | sed 's/,$//; s/,/, #/g')"
      printf 'NEW WORK: BLOCKED\n'
      printf 'Reason: routing=%s for open PR(s) #%s. ' "${_PR_ROUTING:-unknown}" "${_ctx_pr_list:-?}"
      case "${_PR_ROUTING:-}" in
        needs-fix)
          printf 'At least one PR has CHANGES_REQUESTED or is conflicting — fix and push, then STOP.\n' ;;
        needs-fix-bounce)
          printf 'At least one PR was BOUNCED by the overseer (converted to draft + labeled `needs-ai`) — this is NOT "nothing to fix". Follow .claude/agents/worker.md "Re-entry after a bounce (autonomous)": read the bounce comment'"'"'s ### Specific failures, fix each gap, then open a NEW PR referencing the bounced one (pushing a commit to the draft PR is not enough — it stays excluded from the overseer'"'"'s actionable-PR list while in draft). Then STOP.\n' ;;
        awaiting-merge)
          printf 'All open PRs are approved/clean, awaiting a human merge — nothing to fix. Step 0 triage still runs; STOP after it (do not proceed to Step 2).\n' ;;
        needs-attention)
          printf 'At least one PR is open and not yet reviewed — nothing to fix. Step 0 triage still runs; STOP after it (do not proceed to Step 2).\n' ;;
        *)
          printf 'STOP — do not proceed to Step 2.\n' ;;
      esac
    else
      printf 'NEW WORK: ALLOWED\n'
      printf 'Reason: no open PRs authored by this worker.\n'
    fi
    printf '\n'
  fi

  if [[ "${ROLE:-}" == "worker" && -n "${HOS_TARGET_MILESTONE_NUMBER:-}" && -n "${_REPO_SLUG:-}" ]]; then
    printf '### Next work candidates (%s, needs-ai, not needs-human; highest priority first)\n' "${HOS_TARGET_RELEASE:-active milestone}"
    # #901: order by (priority desc, number asc) via the canonical jq filter so
    # this path and the worker-cron-prompt.md Step-2 fallback select identically.
    # per_page=100 (GitHub's single-page max): the priority sort must see the WHOLE
    # backlog, else a high-priority issue on a later page would be missed. A single
    # milestone exceeding 100 open needs-ai issues is the (documented) ceiling.
    # Fail-open: a missing/broken filter yields no section. head -5 caps display
    # only — the worker picks the first non-blocked candidate.
    if [[ -n "${_GATE_CANDIDATES:-}" ]]; then
      printf '%s\n' "$_GATE_CANDIDATES" | head -5
    else
      printf '(none available or fetch failed)\n'
    fi
  fi
}

# #989: the role prompt file carries ALL runtime governance — the untrusted-
# input/prompt-injection policy (#734), the REST-only rule, the Step-4 test/
# validator HARD GATE, the pre-PR stale-commit gate, PR attribution, and the
# identity guard. If it is absent, falling back to an ad-hoc nine-word prompt
# would still launch `claude --permission-mode bypassPermissions` headless with
# full tool access — a guardrail-free autonomous agent. Fail closed instead:
# treat a missing prompt file as a config-level preflight failure (EX_CONFIG).
if [[ ! -f "$PROMPT_FILE" ]]; then
  echo "$LOG_PREFIX FATAL: role prompt file missing: $PROMPT_FILE — refusing guardrail-free bypassPermissions launch"
  _audit cycle-preflight-fail reason=prompt_file_missing
  exit 78  # EX_CONFIG
fi

if [[ "$ROLE" == "overseer" && -n "$_HOS_ACTIONABLE_PRS" ]]; then
  { printf '[hos-cron pre-filter] HOS_ACTIONABLE_PRS: %s | skipped (conflicting/draft): %s\n---\n' \
        "$_HOS_ACTIONABLE_PRS" "${_HOS_SKIPPED_PRS:-none}"; \
    _build_prompt; } | _run_claude || _claude_exit=$?
else
  _build_prompt | _run_claude || _claude_exit=$?
fi

if [[ $_claude_exit -eq 124 ]]; then
  echo "$LOG_PREFIX claude TIMED OUT after ${HOS_CRON_MAX_SECONDS}s — session killed (no last-run written; will retry next fire)"
  _audit cycle-claude-timeout "limit=$HOS_CRON_MAX_SECONDS"

  # #1435: a work item that cannot finish inside the cap becomes a
  # token-burning loop — each fire spends a full session, is killed at the
  # ceiling, discards its work, and the next fire starts over. Trip a breaker
  # after HOS_TIMEOUT_BREAKER_MAX_ATTEMPTS consecutive exit=124s AT AN
  # UNCHANGED CAP. A cap change is a legitimate operator response (human
  # ruling 2, not a blind retry) — it resets the counter instead of tripping,
  # so raising --max-seconds is never a trap.
  _tb_state="$_HOS_DIR/timeout-breaker/${ROLE}-${PROJECT}"
  _tb_max="${HOS_TIMEOUT_BREAKER_MAX_ATTEMPTS:-2}"
  _tb_prev_attempts=0 _tb_prev_cap=""
  if [[ -f "$_tb_state" ]]; then
    _tb_prev_attempts="$(sed -n '1p' "$_tb_state" 2>/dev/null || echo 0)"
    _tb_prev_cap="$(sed -n '2p' "$_tb_state" 2>/dev/null || echo "")"
  fi
  if [[ "$_tb_prev_cap" == "$HOS_CRON_MAX_SECONDS" ]]; then
    _tb_attempts=$(( _tb_prev_attempts + 1 ))
  else
    _tb_attempts=1
  fi
  printf '%s\n%s\n' "$_tb_attempts" "$HOS_CRON_MAX_SECONDS" > "$_tb_state"

  if [[ "$_tb_attempts" -ge "$_tb_max" ]]; then
    echo "$LOG_PREFIX TIMEOUT BREAKER TRIPPED — ${_tb_attempts} consecutive timeouts at ${HOS_CRON_MAX_SECONDS}s cap — suspending project '$PROJECT'"
    _tb_reason="${ROLE} timed out ${_tb_attempts} consecutive cycles at ${HOS_CRON_MAX_SECONDS}s (exit 124); raise with --max-seconds, split the work item, or fix the cause"
    if bash "$_HOS_CRON_DIR/hos-suspend" --project "$PROJECT" --reason "$_tb_reason" >/dev/null 2>&1; then
      echo "$LOG_PREFIX suspended project '$PROJECT' via hos-suspend (no --until — requires explicit --clear, a cap change, or a successful cycle)"
    else
      echo "$LOG_PREFIX WARN: hos-suspend call failed — project NOT suspended, manual action required"
    fi
    _audit cycle-timeout-breaker-tripped "role=$ROLE cap=$HOS_CRON_MAX_SECONDS attempts=$_tb_attempts"

    # Surface the trip as a needs-human issue too — the suspension marker
    # alone is discoverable only via `hos-suspend --list`; this makes it
    # visible in the normal issue queue. Fail-closed dedup mirrors #789/#849:
    # only file when the query SUCCEEDS and confirms zero already-open
    # breaker issues — a query error must never default to "none open" and
    # flood the queue.
    if [[ -n "$_REPO_SLUG" ]]; then
      if _tb_existing=$(gh api "repos/${_REPO_SLUG}/issues?state=open&labels=needs-human&per_page=20" \
          --jq "[.[] | select(.title | startswith(\"${_TIMEOUT_BREAKER_TITLE_PREFIX}\"))] | length" \
          2>/dev/null); then
        _tb_existing="${_tb_existing:-0}"
        if [[ "$_tb_existing" == "0" ]]; then
          gh issue create \
            --repo "$_REPO_SLUG" \
            --title "${_TIMEOUT_BREAKER_TITLE_PREFIX} — worker halted" \
            --label "needs-human,needs-ai" \
            --body "$(printf '`%s` timed out %s consecutive cycles at a %ss cap (exit 124). Each fire spent a full session, was killed at the cap, and discarded its work with no output — the project has been suspended via `hos-suspend` to stop the burn.\n\nA human should investigate the cause, then either:\n\n- raise the cap (`--max-seconds <N>` flag, or `%s_max_seconds` in projects.conf) if the work genuinely needs more time, or\n- split the work item so it fits inside the existing cap, or\n- fix the underlying hang.\n\nResume with:\n\n    hos-suspend --project %s --clear\n' "$ROLE" "$_tb_attempts" "$HOS_CRON_MAX_SECONDS" "$PROJECT" "$PROJECT")" \
            2>/dev/null && echo "$LOG_PREFIX filed timeout-breaker needs-human issue" \
            || echo "$LOG_PREFIX WARN: timeout-breaker issue filing failed"
        else
          echo "$LOG_PREFIX timeout-breaker issue already open — not filing a duplicate"
        fi
      else
        echo "$LOG_PREFIX WARN: timeout-breaker dedup query failed — skipping issue creation (fail-closed) to avoid duplicate filings"
      fi
    fi
  else
    echo "$LOG_PREFIX timeout breaker: attempt ${_tb_attempts}/${_tb_max} at ${HOS_CRON_MAX_SECONDS}s cap"
  fi
elif [[ $_claude_exit -ne 0 ]]; then
  echo "$LOG_PREFIX claude exited $_claude_exit — if auth-related, refresh the token: 'claude setup-token' → $_CLAUDE_AUTH_ENV"
  _audit cycle-claude-fail "exit=$_claude_exit"
fi

# ── DISABLED 2026-09-01 (operator request) ───────────────────────────────────
# The #1446 usage-limit breaker below is COMMENTED OUT, not deleted.
#
# Why: detection is a case-insensitive grep over the session's OWN captured
# transcript. The original reasoning weighed false negatives ("a missed match
# is the safe failure direction") but not false POSITIVES, which are severe:
# it trips on the FIRST match, suspends via hos-suspend with no --until, and
# needs a manual `hos-suspend --clear` to resume. Any session whose output
# merely CONTAINS the phrase trips it — issue #1446's own body, this file,
# the CRON-SETUP docs, or a session discussing usage limits. Documenting the
# breaker can trip the breaker.
