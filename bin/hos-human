#!/usr/bin/env bash
# bin/hos-human -- interactive HOS human-proxy session launcher
#
# Preflight -> authenticate as the Human GitHub App bot -> sync the shared repo ->
# open Claude, for an interactive human-proxy (orchestrator) session. This is the
# canonical session-start command for a Human clone.
#
# NOT an autonomous cron role. bin/hos-cron accepts only --role worker|overseer;
# there is deliberately no human cron role and this launcher must never be wired
# into cron.
#
# Token lifetime note: the sourced GH_TOKEN is a FIRST-HOUR CONVENIENCE for
# interactive `gh` reads only. Commits are local (no token needed). The push/PR
# procedure embeds a fresh token in the remote URL at push time, and the read
# auth snippet (temp-file source, below) re-fetches a fresh token per use -- so a
# stale session token never blocks a load-bearing operation. If a bare `gh` call
# 401s mid-session: re-run the auth snippet, or restart via bin/hos-human.
#
# Usage: hos-human   (from the repo root, or via direnv PATH_add bin)

set -euo pipefail
REPO_ROOT="$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)"

# Preflight -- fail fast before spending any tokens. --role human enables the
# opt-in sandbox-policy currency check (#1221, AD-6); a divergence warns on
# stderr without blocking session start.
bash "$REPO_ROOT/bootstrap/validate_setup.sh" --repo "$REPO_ROOT" --role human \
  || { echo "Preflight failed -- fix setup before starting a session"; exit 1; }

# Auth -- temp-file source pattern (NOT `source <(...)`; see get_app_token.sh
# header. worker/overseer still use source <() -- a known pre-existing
# inconsistency, out of scope here; do not change those files).
_t="$(mktemp)"
# Trap ensures the token file is removed on every exit path, including a
# non-zero return from `source "$_t"` that would otherwise skip the explicit
# rm -f below under set -e.
trap 'rm -f "$_t"' EXIT
if ! "$REPO_ROOT/bootstrap/get_app_token.sh" --app human > "$_t"; then
  echo "Authentication failed"; exit 1
fi
# shellcheck source=/dev/null
source "$_t"

# Identity guard -- portable: compare exported actual vs expected (both set by
# get_app_token.sh), NOT a hardcoded literal. The Human App login does not follow
# the hos-<role>-hos[bot] pattern, so a literal would be wrong.
[[ "${HOS_BOT_LOGIN:-}" == "${HOS_EXPECTED_BOT_LOGIN:-}" && -n "${HOS_BOT_LOGIN:-}" ]] \
  || { echo "Identity guard failed: '${HOS_BOT_LOGIN:-}' != '${HOS_EXPECTED_BOT_LOGIN:-}'"; exit 1; }

# Sync the shared repo at session start (fast-forward only; no-ops if recent).
# Best-effort -- a sync failure must not block the session.
bash "$REPO_ROOT/bootstrap/hos_repo_sync.sh" || true

echo "Authenticated as $HOS_BOT_LOGIN -- starting Claude..."
exec claude
